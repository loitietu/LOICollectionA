{
  "name": "lcui",
  "scopeName": "source.lcui",
  "fileTypes": ["lcui"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#namespaces" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#formClasses" },
    { "include": "#operators" },
    { "include": "#classNames" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "match": "//.*$", "name": "comment.line.double-slash.lcui" },
        { "begin": "/\\*", "end": "\\*/", "name": "comment.block.lcui" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.lcui",
          "patterns": [
            { "match": "\\\\(?:[ntr\\\\\"'])", "name": "constant.character.escape.lcui" }
          ]
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.lcui",
          "patterns": [
            { "match": "\\\\(?:[ntr\\\\\"'])", "name": "constant.character.escape.lcui" }
          ]
        }
      ]
    },
    "numbers": {
      "match": "\\b(?:0x[0-9a-fA-F]+|\\d+\\.\\d*|\\.\\d+|\\d+)\\b",
      "name": "constant.numeric.lcui"
    },
    "namespaces": {
      "match": "\\b(?:mc|ui)(?=\\s*::)",
      "name": "entity.name.namespace.lcui"
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(?:new|func|class|trait|impl|extends|super|this|return|if|for|while|break|continue|in|using|import|component|static|public|private|instanceof|let|const|None|true|false)\\b",
          "name": "keyword.control.lcui"
        }
      ]
    },
    "types": {
      "match": "\\b(?:int|float|string|bool|void|optional|variant)\\b",
      "name": "storage.type.lcui"
    },
    "builtins": {
      "match": "\\b(?:tr|score|entity|print|println|error)\\s*(?=\\()",
      "name": "support.function.builtin.lcui"
    },
    "formClasses": {
      "match": "\\b(?:CustomForm|MessageBox|MessageBoxResult|PaginatedForm|PaginatedFormResult|ScriptForm|UIRawMessage|ObservableBoolean|ObservableNumber|ObservableString|ObservableUIRawMessage)\\b",
      "name": "support.class.builtin.lcui"
    },
    "operators": {
      "match": "::|->|\\+\\+|--|\\+=|-=|\\*=|/=|%=|==|!=|<=|>=|&&|\\|\\||\\?\\?|\\?\\.|\\.\\.|[=+\\-*/%<>!?:;,.()\\[\\]{}|]",
      "name": "keyword.operator.lcui"
    },
    "classNames": {
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
      "name": "entity.name.type.class.lcui"
    },
    "identifiers": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
      "name": "variable.other.lcui"
    }
  }
}
