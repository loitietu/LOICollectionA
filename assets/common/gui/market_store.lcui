import "generic.lcui";

let storeList = new PaginatedForm("market.store.list", {tr("market.gui.title")}, GUIManager::value("market.store.list"), 10) {
    label({tr("market.gui.store.list.label")}, new TextOptions());
    SectionHeader();
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            let idData = GUIManager::request("market.store.list.id", [ result.selectionIndex ]);

            buildStoreDetail(idData[0]);
        :
            GUIManager::open("market", "market.open", 1);
        ]
    });
};

let mineInfoData = GUIManager::request("market.store.mine.info", []);

let navigateUpload = new GlobalValue();
navigateUpload.value = false;

let navigateManage = new GlobalValue();
navigateManage.value = false;

let navigateDissolve = new GlobalValue();
navigateDissolve.value = false;

let navigateAudit = new GlobalValue();
navigateAudit.value = false;

let uploadOption = new ButtonOptions();
uploadOption.tooltip = {tr("market.gui.store.mine.upload.tooltip")};

let manageOption = new ButtonOptions();
manageOption.tooltip = {tr("market.gui.store.mine.manage.tooltip")};

let dissolveOption = new ButtonOptions();
dissolveOption.tooltip = {tr("market.gui.store.mine.dissolve.tooltip")};

let auditOption = new ButtonOptions();
auditOption.tooltip = {tr("market.gui.store.mine.audit.tooltip")};

let mineForm = new CustomForm("market.store.mine", {tr("market.gui.title")}) {
    label(std::format({tr("market.gui.store.mine.label")}, [ mineInfoData[1], mineInfoData[3] ]), new TextOptions());
    SectionHeader();
    button({tr("market.gui.store.mine.upload")}, on: func () -> void {
        let checkData = GUIManager::request("market.store.upload.check", []);

        if (checkData[0]) [
            navigateUpload.value = true;

            this.close();
        ]
    }, uploadOption);
    button({tr("market.gui.store.mine.manage")}, on: func () -> void {
        navigateManage.value = true;

        this.close();
    }, manageOption);
    button({tr("market.gui.store.mine.dissolve")}, on: func () -> void {
        navigateDissolve.value = true;

        this.close();
    }, dissolveOption);

    if (GUIManager::request("market.isAdmin", [])[0] && GUIManager::request("market.store.review.enabled", [])[0]) [
        button({tr("market.gui.store.mine.audit")}, on: func () -> void {
            navigateAudit.value = true;

            this.close();
        }, auditOption);
    ]

    closeButton();
    show(func (result) -> void {
        if (navigateUpload.value) [
            GUIManager::switchTo("market.store.inventory", 3);
            return;
        ]

        if (navigateManage.value) [
            buildStoreMyItems();
            return;
        ]

        if (navigateDissolve.value) [
            buildStoreDissolve();
            return;
        ]

        if (navigateAudit.value) [
            buildPendingReviews();
        :
            GUIManager::open("market", "market.personal", 1);
        ]
    });
};

let createName = new ObservableString("", true);
let createIcon = new ObservableString("", true);
let createIntroduce = new ObservableString("", true);

let createNameOptions = new TextFieldOptions();
createNameOptions.description = {tr("market.gui.store.mine.create.name.placeholder")};

let createIconOptions = new TextFieldOptions();
createIconOptions.description = {tr("market.gui.store.mine.create.icon.placeholder")};

let createIntroduceOptions = new TextFieldOptions();
createIntroduceOptions.description = {tr("market.gui.store.mine.create.introduce.placeholder")};

let createCostData = GUIManager::request("market.store.create.cost", []);

let createDone = new GlobalValue();
createDone.value = false;

let createResult = new GlobalValue();
createResult.value = true;

let createForm = new CustomForm("market.store.create", {tr("market.gui.title")}) {
    label({tr("market.gui.store.mine.create.title")}, new TextOptions());
    label(createCostData[0], new TextOptions());
    SectionHeader();
    textField({tr("market.gui.store.mine.create.name")}, createName, createNameOptions);
    textField({tr("market.gui.store.mine.create.icon")}, createIcon, createIconOptions);
    textField({tr("market.gui.store.mine.create.introduce")}, createIntroduce, createIntroduceOptions);
    ConfirmBar(saveLabel(), func () -> void {
        let createResultData = GUIManager::request("market.store.create.submit", [ createName.getData(), createIcon.getData(), createIntroduce.getData() ]);

        createResult.value = createResultData[0];
        createDone.value = true;

        this.close();
    });
    show(func (result) -> void {
        if (createDone.value) [
            if (createResult.value) [
                GUIManager::open("market.store", "market.store.mine", 1);
            :
                GUIManager::open("market.store", "market.store.create", 1);
            ]
        :
            GUIManager::open("market", "market.personal", 1);
        ]
    });
};

let storeInventory = new PaginatedForm("market.store.inventory", {tr("market.gui.title")}, GUIManager::value("market.store.inventory"), 10) {
    label({tr("market.gui.sell.item.dropdown")}, new TextOptions());
    SectionHeader();
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            let slotData = GUIManager::request("market.store.sell.slot", [ result.selectionIndex ]);

            buildStoreSellItem(slotData[0]);
        :
            GUIManager::open("market.store", "market.store.mine", 1);
        ]
    });
};

func buildStoreDetail(storeId: string) -> void {
    let detailData = GUIManager::request("market.store.info", [ storeId ]);
    let reviewCanData = GUIManager::request("market.store.review.can", [ storeId ]);

    let navigateItems = new GlobalValue();
    navigateItems.value = false;

    let navigateReviews = new GlobalValue();
    navigateReviews.value = false;

    let reviewVisible = new ObservableBoolean(reviewCanData[0], false);

    let reviewOption = new ButtonOptions();
    reviewOption.visible = reviewVisible;

    let detailForm = new CustomForm("market.store.detail", {tr("market.gui.title")}) {
        label(detailData[0], new TextOptions());
        SectionHeader();
        button({tr("market.gui.store.item.buy")}, on: func () -> void {
            navigateItems.value = true;

            this.close();
        }, new ButtonOptions());
        button({tr("market.gui.store.review.button")}, on: func () -> void {
            navigateReviews.value = true;

            this.close();
        }, reviewOption);
        closeButton();
        show(func (result) -> void {
            if (navigateItems.value) [
                buildStoreItems(storeId);
                return;
            ]

            if (navigateReviews.value) [
                buildStoreReviews(storeId);
            :
                GUIManager::open("market.store", "market.store.list", 3);
            ]
        });
    };

    GUIManager::switchTo("market.store.detail", 1);
}

func buildStoreItems(storeId: string) -> void {
    let storeItems = new PaginatedForm("market.store.items", {tr("market.gui.title")}, GUIManager::request("market.store.item.list", [ storeId ]), 10) {
        label({tr("market.gui.label")}, new TextOptions());
        SectionHeader();
        PageControls();
        closeButton();
        show(func (result) -> void {
            if (result.selection != "") [
                let idData = GUIManager::request("market.store.item.id", [ storeId, result.selectionIndex ]);

                buildStoreItemInfo(storeId, idData[0]);
            :
                buildStoreDetail(storeId);
            ]
        });
    };

    GUIManager::switchTo("market.store.items", 3);
}

func buildStoreItemInfo(storeId: string, itemId: string) -> void {
    let itemInfoData = GUIManager::request("market.store.item.info", [ itemId ]);

    let buyDone = new GlobalValue();
    buyDone.value = false;

    let buyResult = new GlobalValue();
    buyResult.value = true;

    let itemInfo = new CustomForm("market.store.item.info", {tr("market.gui.title")}) {
        label(itemInfoData[0], new TextOptions());
        SectionHeader();
        ConfirmBar({tr("market.gui.sell.item.button1")}, func () -> void {
            let buyResultData = GUIManager::request("market.store.buy.submit", [ itemId ]);

            buyResult.value = buyResultData[0];
            buyDone.value = true;

            this.close();
        });
        show(func (result) -> void {
            if (buyDone.value) [
                if (!buyResult.value) [
                    GUIManager::open("market.store", "market.store.list", 3);
                :
                    buildStoreItems(storeId);
                ]
            :
                buildStoreItems(storeId);
            ]
        });
    };

    GUIManager::switchTo("market.store.item.info", 1);
}

func buildStoreReviews(storeId: string) -> void {
    let reviewsData = GUIManager::request("market.store.reviews", [ storeId ]);

    let navigateReviewForm = new GlobalValue();
    navigateReviewForm.value = false;

    let reviews = new PaginatedForm("market.store.reviews", {tr("market.gui.title")}, reviewsData, 10) {
        label({tr("market.gui.store.reviews.label")}, new TextOptions());
        SectionHeader();
        PageControls();
        divider(new DividerOptions());
        ConfirmBar({tr("market.gui.store.review.button")}, func () -> void {
            navigateReviewForm.value = true;

            this.close();
        });
        show(func (result) -> void {
            if (navigateReviewForm.value) [
                buildReviewForm(storeId);
            :
                buildStoreDetail(storeId);
            ]
        });
    };

    GUIManager::switchTo("market.store.reviews", 3);
}

func buildReviewForm(storeId: string) -> void {
    let ratingIndex = new ObservableNumber(0.0, true);
    let ratingItems = [];

    for (i in 1..6) [
        let ratingItem = new DropdownItem();
        ratingItem.label = "" + i;
        ratingItem.value = i - 1;

        ratingItems.push(ratingItem);
    ]

    let reviewContent = new ObservableString("", true);

    let contentOptions = new TextFieldOptions();
    contentOptions.description = {tr("market.gui.store.review.content.placeholder")};

    let reviewDone = new GlobalValue();
    reviewDone.value = false;

    let reviewResult = new GlobalValue();
    reviewResult.value = true;

    let reviewForm = new CustomForm("market.store.review.form", {tr("market.gui.title")}) {
        label({tr("market.gui.store.reviews.label")}, new TextOptions());
        SectionHeader();
        dropdown({tr("market.gui.store.review.rating")}, ratingIndex, ratingItems, new DropdownOptions());
        textField({tr("market.gui.store.review.content")}, reviewContent, contentOptions);
        ConfirmBar(saveLabel(), func () -> void {
            let reviewResultData = GUIManager::request("market.store.review.submit", [ storeId, ratingIndex.getData(), reviewContent.getData() ]);

            reviewResult.value = reviewResultData[0];
            reviewDone.value = true;

            this.close();
        });
        show(func (result) -> void {
            buildStoreReviews(storeId);
        });
    };

    GUIManager::switchTo("market.store.review.form", 1);
}

func buildStoreMyItems() -> void {
    let myItems = new PaginatedForm("market.store.my.items", {tr("market.gui.title")}, GUIManager::value("market.store.mine.items"), 10) {
        label({tr("market.gui.label")}, new TextOptions());
        SectionHeader();
        PageControls();
        closeButton();
        show(func (result) -> void {
            if (result.selection != "") [
                let idData = GUIManager::request("market.store.mine.item.id", [ result.selectionIndex ]);

                buildStoreMyItemInfo(idData[0]);
            :
                GUIManager::open("market.store", "market.store.mine", 1);
            ]
        });
    };

    GUIManager::switchTo("market.store.my.items", 3);
}

func buildStoreMyItemInfo(itemId: string) -> void {
    let itemInfoData = GUIManager::request("market.store.item.info", [ itemId ]);

    let offshelfDone = new GlobalValue();
    offshelfDone.value = false;

    let itemMine = new CustomForm("market.store.my.item.info", {tr("market.gui.title")}) {
        label(itemInfoData[0], new TextOptions());
        SectionHeader();
        ConfirmBar({tr("market.gui.store.item.offshelf")}, func () -> void {
            GUIManager::request("market.store.offshelf.submit", [ itemId ]);

            offshelfDone.value = true;

            this.close();
        });
        show(func (result) -> void {
            buildStoreMyItems();
        });
    };

    GUIManager::switchTo("market.store.my.item.info", 1);
}

func buildStoreDissolve() -> void {
    let dissolveDone = new GlobalValue();
    dissolveDone.value = false;

    let dissolveResult = new GlobalValue();
    dissolveResult.value = true;

    let dissolveForm = new CustomForm("market.store.dissolve", {tr("market.gui.title")}) {
        label({tr("market.gui.store.mine.dissolve.confirm")}, new TextOptions());
        SectionHeader();
        button({tr("market.yes")}, on: func () -> void {
            let dissolveResultData = GUIManager::request("market.store.dissolve.submit", []);

            dissolveResult.value = dissolveResultData[0];
            dissolveDone.value = true;

            this.close();
        }, new ButtonOptions());
        ConfirmBar({tr("market.no")}, func () -> void {
            dissolveResult.value = false;
            dissolveDone.value = true;

            this.close();
        });
        show(func (result) -> void {
            if (dissolveDone.value) [
                if (dissolveResult.value) [
                    GUIManager::open("market", "market.personal", 1);
                :
                    GUIManager::open("market.store", "market.store.mine", 1);
                ]
            :
                GUIManager::open("market.store", "market.store.mine", 1);
            ]
        });
    };

    GUIManager::switchTo("market.store.dissolve", 1);
}

func buildStoreSellItem(slot: int) -> void {
    let itemName = new ObservableString("", true);
    let itemIcon = new ObservableString("", true);
    let itemIntroduce = new ObservableString("", true);
    let itemScore = new ObservableString("", true);

    let itemNameOptions = new TextFieldOptions();
    itemNameOptions.description = {tr("market.gui.sell.sellItem.input1.placeholder")};

    let itemIconOptions = new TextFieldOptions();
    itemIconOptions.description = {tr("market.gui.sell.sellItem.input2.placeholder")};

    let itemIntroduceOptions = new TextFieldOptions();
    itemIntroduceOptions.description = {tr("market.gui.sell.sellItem.input3.placeholder")};

    let itemScoreOptions = new TextFieldOptions();
    itemScoreOptions.description = {tr("market.gui.sell.sellItem.input4.placeholder")};

    let sellDone = new GlobalValue();
    sellDone.value = false;

    let sellResult = new GlobalValue();
    sellResult.value = true;

    let sellItemForm = new CustomForm("market.store.sell.item", {tr("market.gui.title")}) {
        label({tr("market.gui.label")}, new TextOptions());
        SectionHeader();
        textField({tr("market.gui.sell.sellItem.input1")}, itemName, itemNameOptions);
        textField({tr("market.gui.sell.sellItem.input2")}, itemIcon, itemIconOptions);
        textField({tr("market.gui.sell.sellItem.input3")}, itemIntroduce, itemIntroduceOptions);
        textField({tr("market.gui.sell.sellItem.input4")}, itemScore, itemScoreOptions);
        ConfirmBar(saveLabel(), func () -> void {
            let sellResultData = GUIManager::request("market.store.sell.submit", [ slot, itemName.getData(), itemIcon.getData(), itemIntroduce.getData(), itemScore.getData() ]);

            sellResult.value = sellResultData[0];
            sellDone.value = true;

            this.close();
        });
        show(func (result) -> void {
            if (sellDone.value) [
                if (sellResult.value) [
                    GUIManager::open("market.store", "market.store.mine", 1);
                :
                    GUIManager::open("market.store", "market.store.inventory", 3);
                ]
            :
                GUIManager::open("market.store", "market.store.inventory", 3);
            ]
        });
    };

    GUIManager::switchTo("market.store.sell.item", 1);
}

func buildPendingReviews() -> void {
    let pendingData = GUIManager::request("market.store.reviews.pending", []);

    let pending = new PaginatedForm("market.store.reviews.pending", {tr("market.gui.title")}, pendingData, 10) {
        label({tr("market.gui.store.mine.audit")}, new TextOptions());
        SectionHeader();
        PageControls();
        closeButton();
        show(func (result) -> void {
            if (result.selection != "") [
                let idData = GUIManager::request("market.store.reviews.pending.id", [ result.selectionIndex ]);

                buildReviewAudit(idData[0]);
            :
                GUIManager::open("market.store", "market.store.mine", 1);
            ]
        });
    };

    GUIManager::switchTo("market.store.reviews.pending", 3);
}

func buildReviewAudit(reviewId: string) -> void {
    let auditData = GUIManager::request("market.store.review.audit.info", [ reviewId ]);

    let auditDone = new GlobalValue();
    auditDone.value = false;

    let auditForm = new CustomForm("market.store.review.audit", {tr("market.gui.title")}) {
        label(auditData[0], new TextOptions());
        SectionHeader();
        button({tr("market.gui.store.audit.approve")}, on: func () -> void {
            GUIManager::request("market.store.review.audit", [ reviewId, true ]);

            auditDone.value = true;

            this.close();
        }, new ButtonOptions());
        ConfirmBar({tr("market.gui.store.audit.reject")}, func () -> void {
            GUIManager::request("market.store.review.audit", [ reviewId, false ]);

            auditDone.value = true;

            this.close();
        });
        show(func (result) -> void {
            buildPendingReviews();
        });
    };

    GUIManager::switchTo("market.store.review.audit", 1);
}
