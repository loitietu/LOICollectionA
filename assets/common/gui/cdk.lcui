import "generic.lcui";

let navigateNew = new GlobalValue();
navigateNew.value = false;

let navigateRemove = new GlobalValue();
navigateRemove.value = false;

let navigateAward = new GlobalValue();
navigateAward.value = false;

let addCdkOption = new ButtonOptions();
addCdkOption.tooltip = {tr("cdk.gui.addCdk.tooltip")};

let removeCdkOption = new ButtonOptions();
removeCdkOption.tooltip = {tr("cdk.gui.removeCdk.tooltip")};

let addAwardOption = new ButtonOptions();
addAwardOption.tooltip = {tr("cdk.gui.addAward.tooltip")};

let cdkOpen = new CustomForm("cdk.open", {tr("cdk.gui.title")}) {
    label({tr("cdk.gui.label")}, new TextOptions());
    SectionHeader();
    button({tr("cdk.gui.addCdk")}, on: func () -> void {
        if (!navigateNew.value) [
            navigateNew.value = true;

            this.close();
        ]
    }, addCdkOption);
    button({tr("cdk.gui.removeCdk")}, on: func () -> void {
        if (!navigateRemove.value) [
            navigateRemove.value = true;

            this.close();
        ]
    }, removeCdkOption);
    button({tr("cdk.gui.addAward")}, on: func () -> void {
        if (!navigateAward.value) [
            navigateAward.value = true;

            this.close();
        ]
    }, addAwardOption);
    closeButton();
    show(func (result) -> void {
        if (navigateNew.value) [
            GUIManager::switchTo("cdk.new", 1);
            return;
        ]

        if (navigateRemove.value) [
            GUIManager::switchTo("cdk.remove", 3);
            return;
        ]

        if (navigateAward.value) [
            GUIManager::switchTo("cdk.award", 3);
        ]
    });
    show();
};

let cdkInput = new ObservableString("", true);

let cdkInputOptions = new TextFieldOptions();
cdkInputOptions.description = {tr("cdk.gui.convert.input.placeholder")};

let convert = new CustomForm("cdk.convert", {tr("cdk.gui.title")}) {
    label({tr("cdk.gui.label")}, new TextOptions());
    SectionHeader();
    textField({tr("cdk.gui.convert.input")}, cdkInput, cdkInputOptions);
    ConfirmBar(saveLabel(), func () -> void {
        GUIManager::callback("cdk.convert.submit", [ cdkInput.getData() ]);

        this.close();
    });
    show();
};

let newCdkId = new ObservableString("", true);
let newCdkTime = new ObservableString("", true);
let newPersonal = new ObservableBoolean(false, true);

let newCdkIdOptions = new TextFieldOptions();
newCdkIdOptions.description = {tr("cdk.gui.new.input1.placeholder")};

let newCdkTimeOptions = new TextFieldOptions();
newCdkTimeOptions.description = {tr("cdk.gui.new.input2.placeholder")};

let newDone = new GlobalValue();
newDone.value = false;

let cdkNew = new CustomForm("cdk.new", {tr("cdk.gui.title")}) {
    label({tr("cdk.gui.label")}, new TextOptions());
    SectionHeader();
    textField({tr("cdk.gui.new.input1")}, newCdkId, newCdkIdOptions);
    toggle({tr("cdk.gui.new.switch")}, newPersonal, new ToggleOptions());
    textField({tr("cdk.gui.new.input2")}, newCdkTime, newCdkTimeOptions);
    ConfirmBar(saveLabel(), func () -> void {
        GUIManager::callback("cdk.new.submit", [ newCdkId.getData(), newCdkTime.getData(), newPersonal.getData() ]);

        newDone.value = true;

        this.close();
    });
    show(func (result) -> void {
        if (!newDone.value) [
            GUIManager::open("cdk", "cdk.open", 1);
        ]
    });
    show();
};

let remove = new PaginatedForm("cdk.remove", {tr("cdk.gui.title")}, GUIManager::value("cdk.cdks"), 10) {
    label({tr("cdk.gui.remove.label")}, new TextOptions());
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            buildRemoveInfo(result.selection);
        :
            GUIManager::open("cdk", "cdk.open", 1);
        ]
    });
    show();
};

let award = new PaginatedForm("cdk.award", {tr("cdk.gui.title")}, GUIManager::value("cdk.cdks"), 10) {
    label({tr("cdk.gui.award.label")}, new TextOptions());
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            buildAwardInfo(result.selection);
        :
            GUIManager::open("cdk", "cdk.open", 1);
        ]
    });
    show();
};

func buildRemoveInfo(id: string) -> void {
    let removeDone = new GlobalValue();
    removeDone.value = false;

    let removeInfo = new CustomForm("cdk.remove.info", {tr("cdk.gui.title")}) {
        label(std::format({tr("cdk.gui.remove.content")}, [ id ]), new TextOptions());
        SectionHeader();
        ConfirmBar({tr("cdk.gui.remove.yes")}, func () -> void {
            GUIManager::callback("cdk.remove", [ id ]);

            removeDone.value = true;

            this.close();
        });
        show(func (result) -> void {
            if (!removeDone.value) [
                GUIManager::open("cdk", "cdk.open", 1);
            ]
        });
    };

    GUIManager::switchTo("cdk.remove.info", 1);
}

func buildAwardInfo(id: string) -> void {
    let awardInfoData = GUIManager::request("cdk.info", [ id ]);

    let navigateScore = new GlobalValue();
    navigateScore.value = false;

    let navigateItem = new GlobalValue();
    navigateItem.value = false;

    let navigateTitle = new GlobalValue();
    navigateTitle.value = false;

    let awardInfo = new CustomForm("cdk.award.info", {tr("cdk.gui.title")}) {
        label(awardInfoData[0], new TextOptions());
        SectionHeader();
        button({tr("cdk.gui.award.score")}, on: func () -> void {
            if (!navigateScore.value) [
                navigateScore.value = true;

                this.close();
            ]
        }, new ButtonOptions());
        button({tr("cdk.gui.award.item")}, on: func () -> void {
            if (!navigateItem.value) [
                navigateItem.value = true;

                this.close();
            ]
        }, new ButtonOptions());
        ConfirmBar({tr("cdk.gui.award.title")}, func () -> void {
            if (!navigateTitle.value) [
                navigateTitle.value = true;

                this.close();
            ]
        });
        show(func (result) -> void {
            if (navigateScore.value) [
                buildAwardScore(id);
                return;
            ]

            if (navigateItem.value) [
                buildAwardItem(id);
                return;
            ]

            if (navigateTitle.value) [
                buildAwardTitle(id);
            :
                GUIManager::open("cdk", "cdk.open", 1);
            ]
        });
    };

    GUIManager::switchTo("cdk.award.info", 1);
}

func buildAwardScore(id: string) -> void {
    let scoreObjective = new ObservableString("", true);
    let scoreAmount = new ObservableString("", true);

    let scoreObjectiveOptions = new TextFieldOptions();
    scoreObjectiveOptions.description = {tr("cdk.gui.award.score.input1.placeholder")};

    let scoreAmountOptions = new TextFieldOptions();
    scoreAmountOptions.description = {tr("cdk.gui.award.score.input2.placeholder")};

    let scoreDone = new GlobalValue();
    scoreDone.value = false;

    let awardScore = new CustomForm("cdk.award.score", {tr("cdk.gui.title")}) {
        label({tr("cdk.gui.label")}, new TextOptions());
        SectionHeader();
        textField({tr("cdk.gui.award.score.input1")}, scoreObjective, scoreObjectiveOptions);
        textField({tr("cdk.gui.award.score.input2")}, scoreAmount, scoreAmountOptions);
        ConfirmBar(saveLabel(), func () -> void {
            GUIManager::callback("cdk.award.score.submit", [ id, scoreObjective.getData(), scoreAmount.getData() ]);

            scoreDone.value = true;

            this.close();
        });
        show(func (result) -> void {
            if (!scoreDone.value) [
                buildAwardInfo(id);
            ]
        });
    };

    GUIManager::switchTo("cdk.award.score", 1);
}

func buildAwardItem(id: string) -> void {
    let navigateInventory = new GlobalValue();
    navigateInventory.value = false;

    let navigateCustom = new GlobalValue();
    navigateCustom.value = false;

    let awardItem = new CustomForm("cdk.award.item", {tr("cdk.gui.title")}) {
        label({tr("cdk.gui.label")}, new TextOptions());
        SectionHeader();
        button({tr("cdk.gui.award.item.inventory")}, on: func () -> void {
            if (!navigateInventory.value) [
                navigateInventory.value = true;

                this.close();
            ]
        }, new ButtonOptions());
        ConfirmBar({tr("cdk.gui.award.item.custom")}, func () -> void {
            if (!navigateCustom.value) [
                navigateCustom.value = true;

                this.close();
            ]
        });
        show(func (result) -> void {
            if (navigateInventory.value) [
                buildInventory(id);
                return;
            ]

            if (navigateCustom.value) [
                buildItemType(id);
            :
                buildAwardInfo(id);
            ]
        });
    };

    GUIManager::switchTo("cdk.award.item", 1);
}

func buildItemType(id: string) -> void {
    let typeIndex = new ObservableNumber(0.0, true);

    let typeUniversal = new DropdownItem();
    typeUniversal.label = "universal";
    typeUniversal.value = 0;

    let typeNbt = new DropdownItem();
    typeNbt.label = "nbt";
    typeNbt.value = 1;

    let typeItems = [ typeUniversal, typeNbt ];

    let typeDone = new GlobalValue();
    typeDone.value = false;

    let itemType = new CustomForm("cdk.award.item.type", {tr("cdk.gui.title")}) {
        label({tr("cdk.gui.label")}, new TextOptions());
        SectionHeader();
        dropdown({tr("cdk.gui.award.item.custom.dropdown")}, typeIndex, typeItems, new DropdownOptions());
        ConfirmBar(saveLabel(), func () -> void {
            typeDone.value = true;

            this.close();
        });
        show(func (result) -> void {
            if (typeDone.value) [
                if (typeIndex.getData() == 0) [
                    buildItemCommon(id, "universal");
                :
                    buildItemCommon(id, "nbt");
                ]
            :
                buildAwardInfo(id);
            ]
        });
    };

    GUIManager::switchTo("cdk.award.item.type", 1);
}

func buildItemCommon(id: string, itemType: string) -> void {
    let itemId = new ObservableString("", true);
    let itemName = new ObservableString("", true);
    let itemQuantity = new ObservableString("", true);
    let itemSpecialValue = new ObservableString("", true);

    let itemIdOptions = new TextFieldOptions();
    itemIdOptions.description = {tr("cdk.gui.award.item.custom.input1.placeholder")};

    let itemNameOptions = new TextFieldOptions();
    itemNameOptions.description = {tr("cdk.gui.award.item.custom.input2.placeholder")};

    let itemQuantityOptions = new TextFieldOptions();
    itemQuantityOptions.description = {tr("cdk.gui.award.item.custom.input3.placeholder")};

    let itemSpecialValueOptions = new TextFieldOptions();
    itemSpecialValueOptions.description = {tr("cdk.gui.award.item.custom.input4.placeholder")};

    let itemCommonDone = new GlobalValue();
    itemCommonDone.value = false;

    let itemCommon = new CustomForm("cdk.award.item.common", {tr("cdk.gui.title")}) {
        label({tr("cdk.gui.label")}, new TextOptions());
        SectionHeader();
        textField({tr("cdk.gui.award.item.custom.input1")}, itemId, itemIdOptions);

        if (itemType == "universal") [
            textField({tr("cdk.gui.award.item.custom.input2")}, itemName, itemNameOptions);
            textField({tr("cdk.gui.award.item.custom.input3")}, itemQuantity, itemQuantityOptions);
            textField({tr("cdk.gui.award.item.custom.input4")}, itemSpecialValue, itemSpecialValueOptions);
        ]

        ConfirmBar(saveLabel(), func () -> void {
            GUIManager::callback("cdk.award.item.submit", [ id, itemType, itemId.getData(), itemName.getData(), itemQuantity.getData(), itemSpecialValue.getData() ]);

            itemCommonDone.value = true;

            this.close();
        });
        show(func (result) -> void {
            if (!itemCommonDone.value) [
                buildAwardInfo(id);
            ]
        });
    };

    GUIManager::switchTo("cdk.award.item.common", 1);
}

func buildInventory(id: string) -> void {
    let inventory = new PaginatedForm("cdk.award.inventory", {tr("cdk.gui.title")}, GUIManager::value("cdk.inventory"), 10) {
        label({tr("cdk.gui.award.item.inventory.label")}, new TextOptions());
        PageControls();
        closeButton();
        show(func (result) -> void {
            if (result.selection != "") [
                let slotData = GUIManager::request("cdk.inventory.slot", [ result.selectionIndex ]);

                buildInventoryConfirm(id, slotData[0]);
            :
                buildAwardInfo(id);
            ]
        });
    };

    GUIManager::switchTo("cdk.award.inventory", 3);
}

func buildInventoryConfirm(id: string, slot: int) -> void {
    let inventoryItemData = GUIManager::request("cdk.inventory.item", [ id, slot ]);

    let inventoryConfirmDone = new GlobalValue();
    inventoryConfirmDone.value = false;

    let inventoryConfirm = new CustomForm("cdk.award.inventory.confirm", {tr("cdk.gui.title")}) {
        label(inventoryItemData[0], new TextOptions());
        SectionHeader();
        ConfirmBar({tr("cdk.gui.award.item.inventory.yes")}, func () -> void {
            GUIManager::callback("cdk.award.inventory.submit", [ id, slot ]);

            inventoryConfirmDone.value = true;

            this.close();
        });
        show(func (result) -> void {
            if (!inventoryConfirmDone.value) [
                buildInventory(id);
            ]
        });
    };

    GUIManager::switchTo("cdk.award.inventory.confirm", 1);
}

func buildAwardTitle(id: string) -> void {
    let titleText = new ObservableString("", true);
    let titleTime = new ObservableString("", true);

    let titleTextOptions = new TextFieldOptions();
    titleTextOptions.description = {tr("cdk.gui.award.title.input1.placeholder")};

    let titleTimeOptions = new TextFieldOptions();
    titleTimeOptions.description = {tr("cdk.gui.award.title.input2.placeholder")};

    let titleDone = new GlobalValue();
    titleDone.value = false;

    let awardTitle = new CustomForm("cdk.award.title", {tr("cdk.gui.title")}) {
        label({tr("cdk.gui.label")}, new TextOptions());
        SectionHeader();
        textField({tr("cdk.gui.award.title.input1")}, titleText, titleTextOptions);
        textField({tr("cdk.gui.award.title.input2")}, titleTime, titleTimeOptions);
        ConfirmBar(saveLabel(), func () -> void {
            GUIManager::callback("cdk.award.title.submit", [ id, titleText.getData(), titleTime.getData() ]);

            titleDone.value = true;

            this.close();
        });
        show(func (result) -> void {
            if (!titleDone.value) [
                buildAwardInfo(id);
            ]
        });
    };

    GUIManager::switchTo("cdk.award.title", 1);
}
