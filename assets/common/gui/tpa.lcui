import "generic.lcui";

let mode = new CtxValue(0);
let inviteId = new CtxValue(1);

if (mode.value == "invite") [
    let inviteData = GUIManager::request("tpa.invite.info", [ inviteId.value ]);

    let invite = new MessageBox("tpa.invite", {tr("tpa.gui.title")}) {
        body(inviteData[0]);
        button1({tr("tpa.yes")});
        button2({tr("tpa.no")});
        show(func (result) -> void {
            let response = 1;
            if (result instanceof MessageBoxResult) [
                response = result.selection;
            ]

            GUIManager::callback("tpa.invite.response", [ inviteId.value, response ]);
        });
    };
]

let navigateGeneric = new GlobalValue();
navigateGeneric.value = false;

let navigateBlacklist = new GlobalValue();
navigateBlacklist.value = false;

let navigateAddBlacklist = new GlobalValue();
navigateAddBlacklist.value = false;

let genericOption = new ButtonOptions();
genericOption.tooltip = {tr("tpa.gui.setting.generic.tooltip")};

let blacklistOption = new ButtonOptions();
blacklistOption.tooltip = {tr("tpa.gui.setting.blacklist.tooltip")};

let addBlacklistOption = new ButtonOptions();
addBlacklistOption.tooltip = {tr("tpa.gui.setting.blacklist.add.tooltip")};

let setting = new CustomForm("tpa.setting", {tr("tpa.gui.setting.title")}) {
    label({tr("tpa.gui.setting.label")}, new TextOptions());
    SectionHeader();
    button({tr("tpa.gui.setting.generic")}, on: func () -> void {
        if (!navigateGeneric.value) [
            navigateGeneric.value = true;

            this.close();
        ]
    }, genericOption);
    button({tr("tpa.gui.setting.blacklist")}, on: func () -> void {
        if (!navigateBlacklist.value) [
            navigateBlacklist.value = true;

            this.close();
        ]
    }, blacklistOption);
    closeButton();
    show(func (result) -> void {
        if (navigateGeneric.value) [
            GUIManager::switchTo("tpa.generic", 1);
            return;
        ]

        if (navigateBlacklist.value) [
            GUIManager::switchTo("tpa.blacklist", 3);
        ]
    });
    show();
};

let inviteState = new ObservableBoolean(GUIManager::value("tpa.invite")[0], true);
let inviteSaved = new GlobalValue();
inviteSaved.value = false;

let generic = new CustomForm("tpa.generic", {tr("tpa.gui.setting.title")}) {
    label({tr("tpa.gui.setting.label")}, new TextOptions());
    SectionHeader();
    toggle({tr("tpa.gui.setting.generic.switch1")}, inviteState, new ToggleOptions());
    ConfirmBar(saveLabel(), func () -> void {
        if (!inviteSaved.value) [
            GUIManager::callback("tpa.invite.save", [ inviteState.getData() ]);

            inviteSaved.value = true;
            this.close();
        ]
    });
    show(func (result) -> void {
        if (!inviteSaved.value) [
            GUIManager::open("tpa", "tpa.setting", 1, [ "", "" ]);
        ]
    });
    show();
};

let blacklist = new PaginatedForm("tpa.blacklist", {tr("tpa.gui.setting.title")}, GUIManager::value("tpa.blacklists"), 10) {
    label({tr("tpa.gui.setting.label")}, new TextOptions());
    SectionHeader();
    PageControls();
    closeButton();
    divider(new DividerOptions());
    button({tr("tpa.gui.setting.blacklist.add")}, on: func () -> void {
        if (!navigateAddBlacklist.value) [
            navigateAddBlacklist.value = true;

            this.close();
        ]
    }, addBlacklistOption);
    show(func (result) -> void {
        if (navigateAddBlacklist.value) [
            let checkData = GUIManager::request("tpa.blacklist.check", []);
            if (checkData[0]) [
                GUIManager::switchTo("tpa.blacklist.add", 3);
            :
                GUIManager::open("tpa", "tpa.setting", 1, [ "", "" ]);
            ]
        :
            if (result.selection != "") [
                let infoData = GUIManager::request("tpa.blacklist.info", [ result.selection ]);

                let info = new CustomForm("tpa.blacklist.set", {tr("tpa.gui.setting.title")}) {
                    label(infoData[0], new TextOptions());
                    SectionHeader();
                    ConfirmBar({tr("tpa.gui.setting.blacklist.set.remove")}, func () -> void {
                        GUIManager::callback("tpa.blacklist.remove", [ result.selection ]);

                        this.close();
                    });
                    show(func (result) -> void {
                        GUIManager::open("tpa", "tpa.blacklist", 3, [ "", "" ]);
                    });
                };

                GUIManager::switchTo("tpa.blacklist.set", 1);
            :
                GUIManager::open("tpa", "tpa.setting", 1, [ "", "" ]);
            ]
        ]
    });
    show();
};

let blacklistAdd = new PaginatedForm("tpa.blacklist.add", {tr("tpa.gui.setting.title")}, GUIManager::value("tpa.players.add"), 10) {
    label({tr("tpa.gui.setting.blacklist.add.label")}, new TextOptions());
    SectionHeader();
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            GUIManager::request("tpa.blacklist.add.submit", [ result.selectionIndex ]);

            GUIManager::open("tpa", "tpa.setting", 1, [ "", "" ]);
        :
            GUIManager::open("tpa", "tpa.setting", 1, [ "", "" ]);
        ]
    });
    show();
};

let open = new PaginatedForm("tpa.open", {tr("tpa.gui.title")}, GUIManager::value("tpa.players"), 10) {
    label({tr("tpa.gui.label2")}, new TextOptions());
    SectionHeader();
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            let playerData = GUIManager::request("tpa.player.info", [ result.selectionIndex ]);

            buildContent(playerData[0]);
        ]
    });
    show();
};

func buildContent(targetUuid: string) -> void {
    let typeValue = new ObservableNumber(0.0, true);
    let submitDone = new GlobalValue();
    submitDone.value = false;

    let content = new CustomForm("tpa.content", {tr("tpa.gui.title")}) {
        label({tr("tpa.gui.label")}, new TextOptions());
        SectionHeader();
        dropdown({tr("tpa.gui.dropdown")}, typeValue, GUIManager::value("tpa.types"), new DropdownOptions());
        ConfirmBar(saveLabel(), func () -> void {
            let submitResult = GUIManager::request("tpa.content.submit", [ targetUuid, typeValue.getData() ]);

            submitDone.value = submitResult[0];
            this.close();
        });
        show(func (result) -> void {
            if (!submitDone.value) [
                GUIManager::open("tpa", "tpa.open", 3, [ "", "" ]);
            ]
        });
    };

    GUIManager::switchTo("tpa.content", 1);
}
