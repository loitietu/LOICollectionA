import "generic.lcui";

let tradeRequester = new CtxValue(0);
let tradeSeller = new CtxValue(1);
let tradeSlot = new CtxValue(2);
let tradeScore = new CtxValue(3);
let tradeTypeValue = new CtxValue(4);

let selfUuidData = GUIManager::request("market.self.uuid", []);

let requestDestUuid = "";
let requestBuyerUuid = "";

if (tradeTypeValue.value == "sell") [
    requestDestUuid = tradeRequester.value;
    requestBuyerUuid = selfUuidData[0];
:
    requestDestUuid = selfUuidData[0];
    requestBuyerUuid = tradeRequester.value;
]

let requestInfoData = GUIManager::request("market.trade.request.info", [ tradeRequester.value, tradeTypeValue.value ]);

let requestFinished = new GlobalValue();
requestFinished.value = false;

let requestAccepted = new GlobalValue();
requestAccepted.value = false;

let requestRejected = new GlobalValue();
requestRejected.value = false;

let tradeRequest = new CustomForm("market.trade.request", {tr("market.gui.title")}) {
    label(requestInfoData[0], new TextOptions());
    SectionHeader();
    button({tr("market.yes")}, on: func () -> void {
        let acceptData = GUIManager::request("market.trade.request.accept", []);

        requestAccepted.value = acceptData[0];
        requestFinished.value = true;

        this.close();
    }, new ButtonOptions());
    ConfirmBar({tr("market.no")}, func () -> void {
        requestRejected.value = true;
        requestFinished.value = true;

        this.close();
    });
    show(func (result) -> void {
        if (!requestFinished.value) [
            GUIManager::callback("market.trade.request.reject", []);
            return;
        ]

        if (requestAccepted.value) [
            GUIManager::callback("market.trade.open.content", [ requestDestUuid, requestBuyerUuid ]);
            return;
        ]

        if (requestRejected.value) [
            GUIManager::callback("market.trade.request.reject", []);
        ]
    });
    show();
};

let tradeContent = new PaginatedForm("market.trade.content", {tr("market.gui.title")}, GUIManager::value("market.trade.items"), 10) {
    label({tr("market.gui.sell.item.dropdown")}, new TextOptions());
    SectionHeader();
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            let slotData = GUIManager::request("market.trade.slot", [ result.selectionIndex ]);

            GUIManager::callback("market.trade.item", [ tradeRequester.value, slotData[0] ]);
        :
            GUIManager::callback("market.trade.cancel", []);
        ]
    });
    show();
};

let tradeItemInfoData = GUIManager::request("market.trade.item.info", [ tradeSeller.value, tradeSlot.value ]);

let price = new ObservableString("", true);

let priceOptions = new TextFieldOptions();
priceOptions.description = {tr("market.gui.trade.input.placeholder")};

let itemDone = new GlobalValue();
itemDone.value = false;

let tradeItemForm = new CustomForm("market.trade.item", {tr("market.gui.title")}) {
    label(tradeItemInfoData[0], new TextOptions());
    SectionHeader();
    textField({tr("market.gui.trade.input")}, price, priceOptions);
    ConfirmBar(saveLabel(), func () -> void {
        GUIManager::callback("market.trade.item.submit", [ tradeSeller.value, tradeSlot.value, price.getData() ]);

        itemDone.value = true;

        this.close();
    });
    show(func (result) -> void {
        if (!itemDone.value) [
            GUIManager::callback("market.trade.cancel", []);
        ]
    });
    show();
};

let tradeConfirmInfoData = GUIManager::request("market.trade.confirm.info", [ tradeRequester.value, tradeSlot.value, tradeScore.value ]);

let confirmDone = new GlobalValue();
confirmDone.value = false;

let tradeConfirmForm = new CustomForm("market.trade.confirm", {tr("market.gui.title")}) {
    label(tradeConfirmInfoData[0], new TextOptions());
    SectionHeader();
    button({tr("market.yes")}, on: func () -> void {
        GUIManager::callback("market.trade.accept", [ tradeSlot.value, tradeScore.value ]);

        confirmDone.value = true;

        this.close();
    }, new ButtonOptions());
    ConfirmBar({tr("market.no")}, func () -> void {
        GUIManager::callback("market.trade.cancel", []);

        confirmDone.value = true;

        this.close();
    });
    show(func (result) -> void {
        if (!confirmDone.value) [
            GUIManager::callback("market.trade.cancel", []);
        ]
    });
    show();
};
