import "generic.lcui";

tradeRequester = new CtxValue(0);
tradeSeller = new CtxValue(1);
tradeSlot = new CtxValue(2);
tradeScore = new CtxValue(3);
tradeTypeValue = new CtxValue(4);

selfUuidData = GUIManager::request("market.self.uuid", []);

requestDestUuid = "";
requestBuyerUuid = "";

if (tradeTypeValue.value == "sell") [
    requestDestUuid = tradeRequester.value;
    requestBuyerUuid = selfUuidData[0];
:
    requestDestUuid = selfUuidData[0];
    requestBuyerUuid = tradeRequester.value;
]

requestInfoData = GUIManager::request("market.trade.request.info", [ tradeRequester.value, tradeTypeValue.value ]);

requestFinished = new GlobalValue();
requestFinished.value = false;

requestAccepted = new GlobalValue();
requestAccepted.value = false;

requestRejected = new GlobalValue();
requestRejected.value = false;

tradeRequest = new CustomForm("market.trade.request", {tr("market.gui.title")}) {
    label(requestInfoData[0], new TextOptions());
    SectionHeader();
    button({tr("market.yes")}, on: func () -> void {
        acceptData = GUIManager::request("market.trade.request.accept", []);

        requestAccepted.value = acceptData[0];
        requestFinished.value = true;

        this.close();
    }, new ButtonOptions());
    ConfirmBar({tr("market.no")}, func () -> void {
        requestRejected.value = true;
        requestFinished.value = true;

        this.close();
    });
    show(func (result) -> void {
        if (!requestFinished.value) [
            GUIManager::callback("market.trade.request.reject", []);
            return;
        ]

        if (requestAccepted.value) [
            GUIManager::callback("market.trade.open.content", [ requestDestUuid, requestBuyerUuid ]);
            return;
        ]

        if (requestRejected.value) [
            GUIManager::callback("market.trade.request.reject", []);
        ]
    });
    show();
};

tradeContent = new PaginatedForm("market.trade.content", {tr("market.gui.title")}, GUIManager::value("market.trade.items"), 10) {
    label({tr("market.gui.sell.item.dropdown")}, new TextOptions());
    SectionHeader();
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            slotData = GUIManager::request("market.trade.slot", [ result.selectionIndex ]);

            GUIManager::callback("market.trade.item", [ tradeRequester.value, slotData[0] ]);
        :
            GUIManager::callback("market.trade.cancel", []);
        ]
    });
    show();
};

tradeItemInfoData = GUIManager::request("market.trade.item.info", [ tradeSeller.value, tradeSlot.value ]);

price = new ObservableString("", true);

priceOptions = new TextFieldOptions();
priceOptions.description = {tr("market.gui.trade.input.placeholder")};

itemDone = new GlobalValue();
itemDone.value = false;

tradeItemForm = new CustomForm("market.trade.item", {tr("market.gui.title")}) {
    label(tradeItemInfoData[0], new TextOptions());
    SectionHeader();
    textField({tr("market.gui.trade.input")}, price, priceOptions);
    ConfirmBar(saveLabel(), func () -> void {
        GUIManager::callback("market.trade.item.submit", [ tradeSeller.value, tradeSlot.value, price.getData() ]);

        itemDone.value = true;

        this.close();
    });
    show(func (result) -> void {
        if (!itemDone.value) [
            GUIManager::callback("market.trade.cancel", []);
        ]
    });
    show();
};

tradeConfirmInfoData = GUIManager::request("market.trade.confirm.info", [ tradeRequester.value, tradeSlot.value, tradeScore.value ]);

confirmDone = new GlobalValue();
confirmDone.value = false;

tradeConfirmForm = new CustomForm("market.trade.confirm", {tr("market.gui.title")}) {
    label(tradeConfirmInfoData[0], new TextOptions());
    SectionHeader();
    button({tr("market.yes")}, on: func () -> void {
        GUIManager::callback("market.trade.accept", [ tradeSlot.value, tradeScore.value ]);

        confirmDone.value = true;

        this.close();
    }, new ButtonOptions());
    ConfirmBar({tr("market.no")}, func () -> void {
        GUIManager::callback("market.trade.cancel", []);

        confirmDone.value = true;

        this.close();
    });
    show(func (result) -> void {
        if (!confirmDone.value) [
            GUIManager::callback("market.trade.cancel", []);
        ]
    });
    show();
};
