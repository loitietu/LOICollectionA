import "generic.lcui";

mode = new CtxValue(0);
targetId = new CtxValue(1);

if (mode.value == "view") [
    viewData = GUIManager::request("notice.view", [ targetId.value ]);

    view = new CustomForm("notice.view", viewData[0]) {
        label(viewData[1], new TextOptions());
        SectionHeader();
        closeButton();
        show();
    };
]

if (mode.value == "content") [
    contentData = GUIManager::request("notice.content.data", [ targetId.value ]);

    titleField = new ObservableString(contentData[0], true);
    showField = new ObservableBoolean(contentData[1], true);

    navigateLines = new GlobalValue();
    navigateLines.value = false;

    navigateRefresh = new GlobalValue();
    navigateRefresh.value = false;

    content = new CustomForm("notice.content", {tr("notice.gui.title")}) {
        label({tr("notice.gui.label")}, new TextOptions());
        SectionHeader();
        textField({tr("notice.gui.edit.title")}, titleField, new TextFieldOptions());
        toggle({tr("notice.gui.edit.show")}, showField, new ToggleOptions());
        button({tr("notice.gui.edit.lines")}, on: func () -> void {
            if (!navigateLines.value) [
                navigateLines.value = true;

                content.close();
            ]
        }, new ButtonOptions());
        button({tr("notice.gui.edit.addline")}, on: func () -> void {
            if (!navigateRefresh.value) [
                GUIManager::callback("notice.line.add", [ targetId.value ]);

                navigateRefresh.value = true;
                content.close();
            ]
        }, new ButtonOptions());
        button({tr("notice.gui.edit.removeline")}, on: func () -> void {
            if (!navigateRefresh.value) [
                GUIManager::callback("notice.line.remove", [ targetId.value ]);

                navigateRefresh.value = true;
                content.close();
            ]
        }, new ButtonOptions());
        ConfirmBar(saveLabel(), func () -> void {
            if (!navigateRefresh.value) [
                GUIManager::callback("notice.content.save", [ targetId.value, titleField.getData(), showField.getData() ]);

                navigateRefresh.value = true;
                content.close();
            ]
        });
        show(func (result) -> void {
            if (navigateLines.value) [
                linesData = GUIManager::request("notice.lines", [ targetId.value ]);

                lines = new PaginatedForm("notice.lines", {tr("notice.gui.title")}, linesData, 10) {
                    label({tr("notice.gui.label")}, new TextOptions());
                    SectionHeader();
                    PageControls();
                    closeButton();
                    show(func (result) -> void {
                        if (result.selection != "") [
                            lineData = GUIManager::request("notice.line.data", [ targetId.value, result.selectionIndex ]);

                            lineField = new ObservableString(lineData[0], true);

                            line = new CustomForm("notice.line", {tr("notice.gui.title")}) {
                                label({tr("notice.gui.label")}, new TextOptions());
                                SectionHeader();
                                textField(std::format({tr("notice.gui.edit.line")}, [ result.selectionIndex + 1 ]), lineField, new TextFieldOptions());
                                ConfirmBar(saveLabel(), func () -> void {
                                    GUIManager::callback("notice.line.save", [ targetId.value, result.selectionIndex, lineField.getData() ]);

                                    line.close();
                                });
                                show(func (result) -> void {
                                    GUIManager::open("notice", "notice.content", 1, [ "content", targetId.value ]);
                                });
                            };

                            GUIManager::switchTo("notice.line", 1);
                        :
                            GUIManager::open("notice", "notice.content", 1, [ "content", targetId.value ]);
                        ]
                    });
                };

                GUIManager::switchTo("notice.lines", 3);
                return;
            ]

            if (navigateRefresh.value) [
                GUIManager::open("notice", "notice.content", 1, [ "content", targetId.value ]);
            :
                GUIManager::open("notice", "notice.edit", 1, [ "", "" ]);
            ]
        });
    };
]

if (mode.value == "auto") [
    autoData = GUIManager::request("notice.auto", []);

    autoView = new CustomForm("notice.auto", autoData[0]) {
        label(autoData[1], new TextOptions());
        SectionHeader();
        closeButton();
        show();
    };
]

closeState = new ObservableBoolean(GUIManager::value("notice.close")[0], true);

navigateAdd = new GlobalValue();
navigateAdd.value = false;

navigateRemove = new GlobalValue();
navigateRemove.value = false;

navigateEdit = new GlobalValue();
navigateEdit.value = false;

addOption = new ButtonOptions();
addOption.tooltip = {tr("notice.gui.add.tooltip")};

removeOption = new ButtonOptions();
removeOption.tooltip = {tr("notice.gui.remove.tooltip")};

editListOption = new ButtonOptions();
editListOption.tooltip = {tr("notice.gui.edit.list.tooltip")};

edit = new CustomForm("notice.edit", {tr("notice.gui.title")}) {
    label({tr("notice.gui.label")}, new TextOptions());
    SectionHeader();
    button({tr("notice.gui.add")}, on: func () -> void {
        if (!navigateAdd.value) [
            navigateAdd.value = true;

            edit.close();
        ]
    }, addOption);
    button({tr("notice.gui.remove")}, on: func () -> void {
        if (!navigateRemove.value) [
            navigateRemove.value = true;

            edit.close();
        ]
    }, removeOption);
    button({tr("notice.gui.edit.list")}, on: func () -> void {
        if (!navigateEdit.value) [
            navigateEdit.value = true;

            edit.close();
        ]
    }, editListOption);
    closeButton();
    show(func (result) -> void {
        if (navigateAdd.value) [
            GUIManager::switchTo("notice.add", 1);
            return;
        ]

        if (navigateRemove.value) [
            GUIManager::switchTo("notice.remove", 3);
            return;
        ]

        if (navigateEdit.value) [
            GUIManager::switchTo("notice.editList", 3);
        ]
    });
    show();
};

addId = new ObservableString("", true);
addTitle = new ObservableString("", true);
addPriority = new ObservableString("", true);
addShow = new ObservableBoolean(false, true);

addInputOne = new TextFieldOptions();
addInputOne.description = {tr("notice.gui.add.input1.placeholder")};

addInputTwo = new TextFieldOptions();
addInputTwo.description = {tr("notice.gui.add.input2.placeholder")};

addInputThree = new TextFieldOptions();
addInputThree.description = {tr("notice.gui.add.input3.placeholder")};

add = new CustomForm("notice.add", {tr("notice.gui.title")}) {
    label({tr("notice.gui.label")}, new TextOptions());
    SectionHeader();
    textField({tr("notice.gui.add.input1")}, addId, addInputOne);
    textField({tr("notice.gui.add.input2")}, addTitle, addInputTwo);
    textField({tr("notice.gui.add.input3")}, addPriority, addInputThree);
    toggle({tr("notice.gui.add.switch")}, addShow, new ToggleOptions());
    ConfirmBar(saveLabel(), func () -> void {
        GUIManager::callback("notice.add.submit", [ addId.getData(), addTitle.getData(), addPriority.getData(), addShow.getData() ]);

        add.close();
    });
    show(func (result) -> void {
        GUIManager::open("notice", "notice.edit", 1, [ "", "" ]);
    });
    show();
};

remove = new PaginatedForm("notice.remove", {tr("notice.gui.title")}, GUIManager::value("notice.keys"), 10) {
    label({tr("notice.gui.label")}, new TextOptions());
    SectionHeader();
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            confirmId = result.selection;

            confirm = new MessageBox("notice.remove.info", {tr("notice.gui.title")}) {
                body(std::format({tr("notice.gui.remove.content")}, [ result.selection ]));
                button1({tr("notice.gui.remove.yes")});
                button2({tr("notice.gui.remove.no")});
                show(func (result) -> void {
                    if (result instanceof MessageBoxResult) [
                        if (result.selection == 0) [
                            GUIManager::callback("notice.remove", [ confirmId ]);
                        ]
                    ]

                    GUIManager::open("notice", "notice.edit", 1, [ "", "" ]);
                });
            };

            GUIManager::switchTo("notice.remove.info", 2);
        :
            GUIManager::open("notice", "notice.edit", 1, [ "", "" ]);
        ]
    });
    show();
};

editList = new PaginatedForm("notice.editList", {tr("notice.gui.title")}, GUIManager::value("notice.keys"), 10) {
    label({tr("notice.gui.label")}, new TextOptions());
    SectionHeader();
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            GUIManager::open("notice", "notice.content", 1, [ "content", result.selection ]);
        :
            GUIManager::open("notice", "notice.edit", 1, [ "", "" ]);
        ]
    });
    show();
};

setting = new CustomForm("notice.setting", {tr("notice.gui.title")}) {
    label({tr("notice.gui.label")}, new TextOptions());
    SectionHeader();
    toggle({tr("notice.gui.setting.switch1")}, closeState, new ToggleOptions());
    ConfirmBar(saveLabel(), func () -> void {
        GUIManager::callback("notice.setting.save", [ closeState.getData() ]);

        setting.close();
    });
    show();
};

open = new PaginatedForm("notice.open", {tr("notice.gui.title")}, GUIManager::value("notice.names"), 10) {
    label({tr("notice.gui.label")}, new TextOptions());
    SectionHeader();
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            viewData = GUIManager::request("notice.view", [ result.selectionIndex ]);

            view = new CustomForm("notice.view", viewData[0]) {
                label(viewData[1], new TextOptions());
                SectionHeader();
                closeButton();
                show();
            };

            GUIManager::switchTo("notice.view", 1);
        ]
    });
    show();
};
