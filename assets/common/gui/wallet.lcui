import "generic.lcui";

let infoData = GUIManager::request("wallet.info", []);

let navigateOnline = new GlobalValue();
navigateOnline.value = false;

let navigateOffline = new GlobalValue();
navigateOffline.value = false;

let navigateRedenvelope = new GlobalValue();
navigateRedenvelope.value = false;

let navigateWealth = new GlobalValue();
navigateWealth.value = false;

let navigateHistory = new GlobalValue();
navigateHistory.value = false;

let navigateBank = new GlobalValue();
navigateBank.value = false;

let navigateRank = new GlobalValue();
navigateRank.value = false;

let onlineOption = new ButtonOptions();
onlineOption.tooltip = {tr("wallet.gui.transfer.tooltip")};

let offlineOption = new ButtonOptions();
offlineOption.tooltip = {tr("wallet.gui.offlineTransfer.tooltip")};

let redenvelopeOption = new ButtonOptions();
redenvelopeOption.tooltip = {tr("wallet.gui.redenvelope.tooltip")};

let wealthOption = new ButtonOptions();
wealthOption.tooltip = {tr("wallet.gui.wealth.tooltip")};

let historyOption = new ButtonOptions();
historyOption.tooltip = {tr("wallet.gui.history.tooltip")};

let bankOption = new ButtonOptions();
bankOption.tooltip = {tr("wallet.gui.bank.tooltip")};

let rankOption = new ButtonOptions();
rankOption.tooltip = {tr("wallet.gui.rank.tooltip")};

let open = new CustomForm("wallet.open", {tr("wallet.gui.title")}) {
    label(std::format({tr("wallet.gui.label")}, [ infoData[0], infoData[1] ]), new TextOptions());
    SectionHeader();
    button({tr("wallet.gui.transfer")}, on: func () -> void {
        if (!navigateOnline.value) [
            navigateOnline.value = true;

            this.close();
        ]
    }, onlineOption);
    button({tr("wallet.gui.offlineTransfer")}, on: func () -> void {
        if (!navigateOffline.value) [
            navigateOffline.value = true;

            this.close();
        ]
    }, offlineOption);
    button({tr("wallet.gui.redenvelope")}, on: func () -> void {
        if (!navigateRedenvelope.value) [
            navigateRedenvelope.value = true;

            this.close();
        ]
    }, redenvelopeOption);
    button({tr("wallet.gui.wealth")}, on: func () -> void {
        if (!navigateWealth.value) [
            GUIManager::callback("wallet.wealth", []);

            navigateWealth.value = true;
            this.close();
        ]
    }, wealthOption);
    button({tr("wallet.gui.history")}, on: func () -> void {
        if (!navigateHistory.value) [
            navigateHistory.value = true;

            this.close();
        ]
    }, historyOption);
    button({tr("wallet.gui.bank")}, on: func () -> void {
        if (!navigateBank.value) [
            navigateBank.value = true;

            this.close();
        ]
    }, bankOption);
    button({tr("wallet.gui.rank")}, on: func () -> void {
        if (!navigateRank.value) [
            navigateRank.value = true;

            this.close();
        ]
    }, rankOption);
    closeButton();
    show(func (result) -> void {
        if (navigateOnline.value) [
            GUIManager::switchTo("wallet.transfer.online", 3);
            return;
        ]

        if (navigateOffline.value) [
            GUIManager::switchTo("wallet.transfer.offline", 3);
            return;
        ]

        if (navigateRedenvelope.value) [
            GUIManager::switchTo("wallet.redenvelope", 1);
            return;
        ]

        if (navigateHistory.value) [
            GUIManager::switchTo("wallet.history", 3);
            return;
        ]

        if (navigateBank.value) [
            GUIManager::switchTo("wallet.bank", 1);
            return;
        ]

        if (navigateRank.value) [
            GUIManager::switchTo("wallet.rank", 3);
        ]
    });
    show();
};

func buildTransferContent(transferType: string, index: int) -> void {
    let targetData = GUIManager::request("wallet.transfer.info", [ transferType, index ]);
    infoData = GUIManager::request("wallet.info", []);

    let amountField = new ObservableString("", true);
    let submitDone = new GlobalValue();
    submitDone.value = false;

    let content = new CustomForm("wallet.content", {tr("wallet.gui.title")}) {
        label(
            std::format({tr("wallet.gui.label")}, [ infoData[0], infoData[1] ]) + "\n" +
            std::format({tr("wallet.gui.transfer.label2")}, [ targetData[1] ]),
            new TextOptions()
        );
        SectionHeader();
        textField({tr("wallet.gui.transfer.input")}, amountField, transferInputOption);
        ConfirmBar(saveLabel(), func () -> void {
            let submitResult = GUIManager::request("wallet.transfer.submit", [ targetData[0], targetData[1], transferType, amountField.getData() ]);

            if (submitResult[1] == true) [
                let confirmUuid = targetData[0];
                let confirmName = targetData[1];
                let confirmMoney = amountField.getData();
                let confirmTransferType = transferType;

                let confirmTransfer = new MessageBox("wallet.confirm", {tr("wallet.gui.title")}) {
                    body(std::format({tr("wallet.gui.transfer.confirm")}, [ submitResult[2], submitResult[3] ]));
                    button1(saveLabel());
                    button2(cancelLabel());
                    show(func (result) -> void {
                        if (result instanceof MessageBoxResult) [
                            if (result.selection == 0) [
                                GUIManager::callback("wallet.transfer.confirm", [ confirmUuid, confirmName, confirmMoney ]);
                            ]
                        ]

                        GUIManager::open("wallet", "wallet.open", 1, []);
                    });
                };

                GUIManager::switchTo("wallet.confirm", 2);
            :
                submitDone.value = submitResult[0];
                this.close();
            ]
        });
        show(func (result) -> void {
            if (!submitDone.value) [
                GUIManager::open("wallet", "wallet.transfer." + transferType, 3, []);
            ]
        });
    };

    GUIManager::switchTo("wallet.content", 1);
}

let transferInputOption = new TextFieldOptions();
transferInputOption.description = {tr("wallet.gui.transfer.input.placeholder")};

let transferOnline = new PaginatedForm("wallet.transfer.online", {tr("wallet.gui.title")}, GUIManager::value("wallet.players.online"), 10) {
    label({tr("wallet.gui.transfer.label1")}, new TextOptions());
    SectionHeader();
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            buildTransferContent("online", result.selectionIndex);
        :
            GUIManager::open("wallet", "wallet.open", 1, []);
        ]
    });
    show();
};

let transferOffline = new PaginatedForm("wallet.transfer.offline", {tr("wallet.gui.title")}, GUIManager::value("wallet.players.offline"), 10) {
    label({tr("wallet.gui.transfer.label1")}, new TextOptions());
    SectionHeader();
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            buildTransferContent("offline", result.selectionIndex);
        :
            GUIManager::open("wallet", "wallet.open", 1, []);
        ]
    });
    show();
};

let redeemScore = new ObservableString("", true);
let redeemCount = new ObservableString("", true);
let redeemKey = new ObservableString("", true);
let redeemTargets = new ObservableString("", true);
let redeemDone = new GlobalValue();
redeemDone.value = false;

let redeemInputOne = new TextFieldOptions();
redeemInputOne.description = {tr("wallet.gui.redenvelope.input1.placeholder")};

let redeemInputTwo = new TextFieldOptions();
redeemInputTwo.description = {tr("wallet.gui.redenvelope.input2.placeholder")};

let redeemInputThree = new TextFieldOptions();
redeemInputThree.description = {tr("wallet.gui.redenvelope.input3.placeholder")};

let redeemInputFour = new TextFieldOptions();
redeemInputFour.description = {tr("wallet.gui.redenvelope.input4.placeholder")};

let redenvelope = new CustomForm("wallet.redenvelope", {tr("wallet.gui.title")}) {
    label(std::format({tr("wallet.gui.label")}, [ infoData[0], infoData[1] ]), new TextOptions());
    SectionHeader();
    textField({tr("wallet.gui.redenvelope.input1")}, redeemScore, redeemInputOne);
    textField({tr("wallet.gui.redenvelope.input2")}, redeemCount, redeemInputTwo);
    textField({tr("wallet.gui.redenvelope.input3")}, redeemKey, redeemInputThree);
    textField({tr("wallet.gui.redenvelope.input4")}, redeemTargets, redeemInputFour);
    ConfirmBar(saveLabel(), func () -> void {
        let submitResult = GUIManager::request("wallet.redenvelope.submit", [ redeemScore.getData(), redeemCount.getData(), redeemKey.getData(), redeemTargets.getData() ]);

        redeemDone.value = submitResult[0];
        this.close();
    });
    show(func (result) -> void {
        if (!redeemDone.value) [
            GUIManager::open("wallet", "wallet.open", 1, []);
        ]
    });
    show();
};

let history = new PaginatedForm("wallet.history", {tr("wallet.gui.title")}, GUIManager::value("wallet.history"), 10) {
    label({tr("wallet.gui.history.label")}, new TextOptions());
    SectionHeader();
    previousButton(pagePrevious());
    nextButton(pageNext());
    closeButton();
    show(func (result) -> void {
        if (result.selection == "") [
            GUIManager::open("wallet", "wallet.open", 1, []);
        ]
    });
    show();
};

let bankInfoData = GUIManager::request("wallet.bank.info", []);

let bankDepositInput = new ObservableString("", true);
let bankDone = new GlobalValue();
bankDone.value = false;

let bankDepositInputOption = new TextFieldOptions();
bankDepositInputOption.description = {tr("wallet.gui.bank.deposit.input.placeholder")};

let bank = new CustomForm("wallet.bank", {tr("wallet.gui.title")}) {
    label(
        std::format({tr("wallet.gui.label")}, [ infoData[0], infoData[1] ]) + "\n" +
        std::format({tr("wallet.gui.bank.label")}, [ bankInfoData[0], bankInfoData[1] ]),
        new TextOptions()
    );
    SectionHeader();
    textField({tr("wallet.gui.bank.deposit.input")}, bankDepositInput, bankDepositInputOption);
    button({tr("wallet.gui.bank.deposit.button")}, on: func () -> void {
        let bankResult = GUIManager::request("wallet.bank.deposit", [ bankDepositInput.getData() ]);

        bankDone.value = bankResult[0];
        this.close();
    }, new ButtonOptions());
    ConfirmBar({tr("wallet.gui.bank.withdraw.button")}, func () -> void {
        bankResult = GUIManager::request("wallet.bank.withdraw", []);

        bankDone.value = bankResult[0];
        this.close();
    });
    show(func (result) -> void {
        if (!bankDone.value) [
            GUIManager::open("wallet", "wallet.open", 1, []);
        ]
    });
    show();
};

let rankSelfData = GUIManager::request("wallet.rank.self", []);

