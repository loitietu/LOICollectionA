import "generic.lcui";

func getPvpLabel() -> string {
    return std::format({tr("pvp.gui.label")}, GUIManager::value("pvp.isEnable"));
}

let pvpOnOption = new ButtonOptions();
pvpOnOption.tooltip = {tr("pvp.gui.on.tooltip")};

let pvpOffOption = new ButtonOptions();
pvpOffOption.tooltip = {tr("pvp.gui.off.tooltip")};

let pvpLabel = new ObservableString(getPvpLabel(), false);

let open = new CustomForm("pvp.open", {tr("pvp.gui.title")}) {
    label(pvpLabel, new TextOptions());
    SectionHeader();
    button({tr("pvp.gui.on")}, on: func () -> void {
        GUIManager::callback("pvp.enable", [ true ]);

        pvpLabel.setData(getPvpLabel());
    }, pvpOnOption);
    button({tr("pvp.gui.off")}, on: func () -> void {
        GUIManager::callback("pvp.enable", [ false ]);

        pvpLabel.setData(getPvpLabel());
    }, pvpOffOption);
    closeButton();
    show();
};
