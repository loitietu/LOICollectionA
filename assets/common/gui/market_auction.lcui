import "generic.lcui";

let navigateAuctionCreate = new GlobalValue();
navigateAuctionCreate.value = false;

let navigateAuctionMine = new GlobalValue();
navigateAuctionMine.value = false;

let createOption = new ButtonOptions();
createOption.tooltip = {tr("market.gui.auction.create.tooltip")};

let mineOption = new ButtonOptions();
mineOption.tooltip = {tr("market.gui.auction.mine.tooltip")};

let auction = new PaginatedForm("market.auction", {tr("market.gui.title")}, GUIManager::value("market.auction.items"), 10) {
    label({tr("market.gui.auction.list.label")}, new TextOptions());
    SectionHeader();
    PageControls();
    divider(new DividerOptions());
    button({tr("market.gui.auction.create")}, on: func () -> void {
        if (!navigateAuctionCreate.value) [
            navigateAuctionCreate.value = true;

            this.close();
        ]
    }, createOption);
    button({tr("market.gui.auction.mine")}, on: func () -> void {
        if (!navigateAuctionMine.value) [
            navigateAuctionMine.value = true;

            this.close();
        ]
    }, mineOption);
    closeButton();
    show(func (result) -> void {
        if (navigateAuctionCreate.value) [
            buildAuctionInventory();
            return;
        ]

        if (navigateAuctionMine.value) [
            buildAuctionMine();
            return;
        ]

        if (result.selection != "") [
            let idData = GUIManager::request("market.auction.id", [ result.selectionIndex ]);

            buildAuctionInfo(idData[0]);
        :
            GUIManager::open("market", "market.open", 1);
        ]
    });
    show();
};

func buildAuctionInfo(id: string) -> void {
    let infoData = GUIManager::request("market.auction.info", [ id ]);

    let bidPrice = new ObservableString("", true);

    let bidOptions = new TextFieldOptions();
    bidOptions.description = {tr("market.gui.auction.bid.price.placeholder")};

    let bidDone = new GlobalValue();
    bidDone.value = false;

    let bidResult = new GlobalValue();
    bidResult.value = true;

    let auctionInfo = new CustomForm("market.auction.info", {tr("market.gui.title")}) {
        label(infoData[0], new TextOptions());
        SectionHeader();
        textField({tr("market.gui.auction.bid.price")}, bidPrice, bidOptions);
        ConfirmBar({tr("market.gui.auction.bid")}, func () -> void {
            let bidResultData = GUIManager::request("market.auction.bid.submit", [ id, bidPrice.getData() ]);

            bidResult.value = bidResultData[0];
            bidDone.value = true;

            this.close();
        });
        show(func (result) -> void {
            if (bidDone.value) [
                if (bidResult.value) [
                    GUIManager::open("market.auction", "market.auction", 3);
                :
                    GUIManager::open("market.auction", "market.auction", 3);
                ]
            :
                GUIManager::open("market.auction", "market.auction", 3);
            ]
        });
    };

    GUIManager::switchTo("market.auction.info", 1);
}

func buildAuctionInventory() -> void {
    let auctionInventory = new PaginatedForm("market.auction.inventory", {tr("market.gui.title")}, GUIManager::value("market.sell.inventory"), 10) {
        label({tr("market.gui.sell.item.dropdown")}, new TextOptions());
        SectionHeader();
        PageControls();
        closeButton();
        show(func (result) -> void {
            if (result.selection != "") [
                let slotData = GUIManager::request("market.auction.slot", [ result.selectionIndex ]);

                buildAuctionCreate(slotData[0]);
            :
                GUIManager::open("market.auction", "market.auction", 3);
            ]
        });
    };

    GUIManager::switchTo("market.auction.inventory", 3);
}

func buildAuctionCreate(slot: int) -> void {
    let durationBoundsData = GUIManager::request("market.auction.duration.bounds", []);

    let auctionName = new ObservableString("", true);
    let auctionPrice = new ObservableString("", true);
    let auctionDuration = new ObservableString("", true);

    let nameOptions = new TextFieldOptions();
    nameOptions.description = {tr("market.gui.auction.create.name.placeholder")};

    let priceOptions = new TextFieldOptions();
    priceOptions.description = {tr("market.gui.auction.create.price.placeholder")};

    let durationOptions = new TextFieldOptions();
    durationOptions.description = std::format({tr("market.gui.auction.create.duration.placeholder")}, [ durationBoundsData[0], durationBoundsData[1] ]);

    let createDone = new GlobalValue();
    createDone.value = false;

    let createResult = new GlobalValue();
    createResult.value = true;

    let auctionCreate = new CustomForm("market.auction.create", {tr("market.gui.title")}) {
        label({tr("market.gui.label")}, new TextOptions());
        SectionHeader();
        textField({tr("market.gui.auction.create.name")}, auctionName, nameOptions);
        textField({tr("market.gui.auction.create.price")}, auctionPrice, priceOptions);
        textField({tr("market.gui.auction.create.duration")}, auctionDuration, durationOptions);
        ConfirmBar(saveLabel(), func () -> void {
            let createResultData = GUIManager::request("market.auction.create.submit", [ slot, auctionName.getData(), auctionPrice.getData(), auctionDuration.getData() ]);

            createResult.value = createResultData[0];
            createDone.value = true;

            this.close();
        });
        show(func (result) -> void {
            if (createDone.value) [
                if (createResult.value) [
                    GUIManager::open("market.auction", "market.auction", 3);
                :
                    GUIManager::open("market.auction", "market.auction", 3);
                ]
            :
                GUIManager::open("market.auction", "market.auction", 3);
            ]
        });
    };

    GUIManager::switchTo("market.auction.create", 1);
}

func buildAuctionMine() -> void {
    let auctionMine = new PaginatedForm("market.auction.mine", {tr("market.gui.title")}, GUIManager::value("market.my.auction"), 10) {
        label({tr("market.gui.auction.mine.label")}, new TextOptions());
        SectionHeader();
        PageControls();
        closeButton();
        show(func (result) -> void {
            if (result.selection != "") [
                let idData = GUIManager::request("market.my.auction.id", [ result.selectionIndex ]);

                buildAuctionMineInfo(idData[0]);
            :
                GUIManager::open("market.auction", "market.auction", 3);
            ]
        });
    };

    GUIManager::switchTo("market.auction.mine", 3);
}

func buildAuctionMineInfo(id: string) -> void {
    let infoData = GUIManager::request("market.auction.info", [ id ]);

    let auctionMineInfo = new CustomForm("market.auction.mine.info", {tr("market.gui.title")}) {
        label(infoData[0], new TextOptions());
        SectionHeader();
        closeButton();
        show(func (result) -> void {
            GUIManager::open("market.auction", "market.auction.mine", 3);
        });
    };

    GUIManager::switchTo("market.auction.mine.info", 1);
}
