import "generic.lcui";

let quote = new PaginatedForm("market.quote", {tr("market.gui.title")}, GUIManager::value("market.quote.items"), 10) {
    label({tr("market.gui.quote.list.label")}, new TextOptions());
    SectionHeader();
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            let nameData = GUIManager::request("market.quote.id", [ result.selectionIndex ]);

            buildQuoteInfo(nameData[0]);
        :
            GUIManager::open("market", "market.open", 1);
        ]
    });
    show();
};

func buildQuoteInfo(name: string) -> void {
    let infoData = GUIManager::request("market.quote.info", [ name ]);

    let quoteInfo = new CustomForm("market.quote.info", {tr("market.gui.title")}) {
        label(infoData[0], new TextOptions());
        SectionHeader();
        closeButton();
        show(func (result) -> void {
            GUIManager::open("market.quote", "market.quote", 3);
        });
    };

    GUIManager::switchTo("market.quote.info", 1);
}
