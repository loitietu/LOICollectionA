import "generic.lcui";

let addMuteOption = new ButtonOptions();
addMuteOption.tooltip = {tr("mute.gui.addMute.tooltip")};

let removeMuteOption = new ButtonOptions();
removeMuteOption.tooltip = {tr("mute.gui.removeMute.tooltip")};

let navigateAdd = new GlobalValue();
navigateAdd.value = false;

let navigateDelete = new GlobalValue();
navigateDelete.value = false;

let open = new CustomForm("mute.open", {tr("mute.gui.title")}) {
    label({tr("mute.gui.label")}, new TextOptions());
    SectionHeader();
    button({tr("mute.gui.addMute")}, on: func () -> void {
        if (!navigateAdd.value) [
            navigateAdd.value = true;

            this.close();
        ]
    }, addMuteOption);
    button({tr("mute.gui.removeMute")}, on: func () -> void {
        if (!navigateDelete.value) [
            navigateDelete.value = true;

            this.close();
        ]
    }, removeMuteOption);
    closeButton();
    show(func (result) -> void {
        if (navigateAdd.value) [
            GUIManager::switchTo("mute.add", 3);
            return;
        ]

        if (navigateDelete.value) [
            GUIManager::switchTo("mute.remove", 3);
        ]
    });
    show();
};

let add = new PaginatedForm("mute.add", {tr("mute.gui.add.title")}, GUIManager::value("mute.players"), 10) {
    label({tr("mute.gui.add.label")}, new TextOptions());
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            if (GUIManager::request("mute.online", [ result.selection ])[0]) [
                let contentValue = new GlobalValue();
                contentValue.value = false;

                let cause = new ObservableString("", true);
                let duration = new ObservableString("", true);

                let addInputOne = new TextFieldOptions();
                addInputOne.description = {tr("mute.gui.add.input1.placeholder")};

                let addInputTwo = new TextFieldOptions();
                addInputTwo.description = {tr("mute.gui.add.input2.placeholder")};

                let content = new CustomForm("mute.content", {tr("mute.gui.add.title")}) {
                    label({tr("mute.gui.label")}, new TextOptions());
                    SectionHeader();
                    textField({tr("mute.gui.add.input1")}, cause, addInputOne);
                    textField({tr("mute.gui.add.input2")}, duration, addInputTwo);
                    ConfirmBar(saveLabel(), func () -> void {
                        GUIManager::callback("mute.submit", [ result.selection, cause.getData(), duration.getData() ]);

                        contentValue.value = true;

                        this.close();
                    });
                    show(func (result) -> void {
                        if (!contentValue.value) [
                            GUIManager::open("mute", "mute.add", 3);
                        ]
                    });
                };

                GUIManager::switchTo("mute.content", 1);
            :
                GUIManager::callback("mute.add", [ result ]);

                GUIManager::open("mute", "mute.open", 1);
            ]
        :
            GUIManager::open("mute", "mute.open", 1);
        ]
    });
};

let remove = new PaginatedForm("mute.remove", {tr("mute.gui.remove.title")}, GUIManager::value("mute.mutes"), 10) {
    label({tr("mute.gui.remove.label")}, new TextOptions());
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            let infoData = GUIManager::request("mute.info", [ result.selection ]);
            if (infoData) [
                let infoRemoved = new GlobalValue();
                infoRemoved.value = false;

                let info = new CustomForm("mute.info", {tr("mute.gui.remove.title")}) {
                    label(
                        std::format({tr("mute.gui.info.label")}, infoData),
                        new TextOptions()
                    );
                    SectionHeader();
                    ConfirmBar({tr("mute.gui.info.remove")}, func () -> void {
                        GUIManager::callback("mute.info.remove", [ result.selection ]);

                        infoRemoved.value = true;

                        this.close();
                    });
                    show(func (result) -> void {
                        if (!infoRemoved.value) [
                            GUIManager::open("mute", "mute.remove", 3);
                        ]
                    });
                };

                GUIManager::switchTo("mute.info", 1);
            :
                GUIManager::callback("mute.remove", [ result ]);

                GUIManager::open("mute", "mute.remove", 3);
            ]
        :
            GUIManager::open("mute", "mute.open", 1);
        ]
    });
};
