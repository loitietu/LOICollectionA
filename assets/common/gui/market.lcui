import "generic.lcui";

navigateBuy = new GlobalValue();
navigateBuy.value = false;

navigateStore = new GlobalValue();
navigateStore.value = false;

navigateTrade = new GlobalValue();
navigateTrade.value = false;

navigatePersonal = new GlobalValue();
navigatePersonal.value = false;

navigateQuote = new GlobalValue();
navigateQuote.value = false;

navigateWanted = new GlobalValue();
navigateWanted.value = false;

navigateAuction = new GlobalValue();
navigateAuction.value = false;

worldbuyOption = new ButtonOptions();
worldbuyOption.tooltip = {tr("market.gui.worldbuy.tooltip")};

storeEnabled = GUIManager::request("market.store.enabled", [])[0];
storeVisible = new ObservableBoolean(storeEnabled, false);

storeOption = new ButtonOptions();
storeOption.tooltip = {tr("market.gui.store.tooltip")};
storeOption.visible = storeVisible;

tradeOption = new ButtonOptions();
tradeOption.tooltip = {tr("market.gui.trade.tooltip")};

personalOption = new ButtonOptions();
personalOption.tooltip = {tr("market.gui.personal.tooltip")};

quoteEnabled = GUIManager::request("market.quote.enabled", [])[0];
quoteVisible = new ObservableBoolean(quoteEnabled, false);

quoteOption = new ButtonOptions();
quoteOption.tooltip = {tr("market.gui.quote.tooltip")};
quoteOption.visible = quoteVisible;

wantedEnabled = GUIManager::request("market.wanted.enabled", [])[0];
wantedVisible = new ObservableBoolean(wantedEnabled, false);

wantedOption = new ButtonOptions();
wantedOption.tooltip = {tr("market.gui.wanted.tooltip")};
wantedOption.visible = wantedVisible;

auctionEnabled = GUIManager::request("market.auction.enabled", [])[0];
auctionVisible = new ObservableBoolean(auctionEnabled, false);

auctionOption = new ButtonOptions();
auctionOption.tooltip = {tr("market.gui.auction.tooltip")};
auctionOption.visible = auctionVisible;

buyItemOption = new ButtonOptions();
buyItemOption.tooltip = {tr("market.gui.sell.item.button1.tooltip")};

delistItemOption = new ButtonOptions();
delistItemOption.tooltip = {tr("market.gui.sell.item.button2.tooltip")};

marketOpen = new CustomForm("market.open", {tr("market.gui.title")}) {
    label({tr("market.gui.label")}, new TextOptions());
    SectionHeader();
    button({tr("market.gui.worldbuy")}, on: func () -> void {
        if (!navigateBuy.value) [
            navigateBuy.value = true;

            marketOpen.close();
        ]
    }, worldbuyOption);
    button({tr("market.gui.store")}, on: func () -> void {
        if (!navigateStore.value) [
            navigateStore.value = true;

            marketOpen.close();
        ]
    }, storeOption);
    button({tr("market.gui.quote")}, on: func () -> void {
        if (!navigateQuote.value) [
            navigateQuote.value = true;

            marketOpen.close();
        ]
    }, quoteOption);
    button({tr("market.gui.wanted")}, on: func () -> void {
        if (!navigateWanted.value) [
            navigateWanted.value = true;

            marketOpen.close();
        ]
    }, wantedOption);
    button({tr("market.gui.auction")}, on: func () -> void {
        if (!navigateAuction.value) [
            navigateAuction.value = true;

            marketOpen.close();
        ]
    }, auctionOption);
    button({tr("market.gui.trade")}, on: func () -> void {
        if (!navigateTrade.value) [
            navigateTrade.value = true;

            marketOpen.close();
        ]
    }, tradeOption);
    button({tr("market.gui.personal")}, on: func () -> void {
        if (!navigatePersonal.value) [
            navigatePersonal.value = true;

            marketOpen.close();
        ]
    }, personalOption);
    closeButton();
    show(func (result) -> void {
        if (navigateStore.value) [
            GUIManager::open("market.store", "market.store.list", 3);
        :
            if (navigateQuote.value) [
                GUIManager::open("market.quote", "market.quote", 3);
            :
                if (navigateWanted.value) [
                    GUIManager::open("market.wanted", "market.wanted", 3);
                :
                    if (navigateAuction.value) [
                        GUIManager::open("market.auction", "market.auction", 3);
                    :
                        if (navigateBuy.value) [
                            GUIManager::switchTo("market.buy", 3);
                        :
                            if (navigateTrade.value) [
                                GUIManager::switchTo("market.trade", 3);
                            :
                                if (navigatePersonal.value) [
                                    GUIManager::switchTo("market.personal", 1);
                                ]
                            ]
                        ]
                    ]
                ]
            ]
        ]
    });
    show();
};

buy = new PaginatedForm("market.buy", {tr("market.gui.title")}, GUIManager::value("market.buy.items"), 10) {
    label({tr("market.gui.label")}, new TextOptions());
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            idData = GUIManager::request("market.buy.id", [ result.selectionIndex ]);

            buildItemInfo(idData[0]);
        :
            GUIManager::open("market", "market.open", 1);
        ]
    });
    show();
};

trade = new PaginatedForm("market.trade", {tr("market.gui.title")}, GUIManager::value("market.players"), 10) {
    label({tr("market.gui.trade.label")}, new TextOptions());
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            uuidData = GUIManager::request("market.players.uuid", [ result.selectionIndex ]);

            buildTradeType(uuidData[0]);
        :
            GUIManager::open("market", "market.open", 1);
        ]
    });
    show();
};

navigateSellItem = new GlobalValue();
navigateSellItem.value = false;

navigateSellContent = new GlobalValue();
navigateSellContent.value = false;

navigateBlacklist = new GlobalValue();
navigateBlacklist.value = false;

navigateStoreMine = new GlobalValue();
navigateStoreMine.value = false;

sellItemOption = new ButtonOptions();
sellItemOption.tooltip = {tr("market.gui.personal.sellItem.tooltip")};

sellItemContentOption = new ButtonOptions();
sellItemContentOption.tooltip = {tr("market.gui.personal.sellItemContent.tooltip")};

blacklistOption = new ButtonOptions();
blacklistOption.tooltip = {tr("market.gui.personal.blacklist.tooltip")};

storeMineOption = new ButtonOptions();
storeMineOption.tooltip = {tr("market.gui.store.mine.tooltip")};

marketPersonal = new CustomForm("market.personal", {tr("market.gui.title")}) {
    label({tr("market.gui.label")}, new TextOptions());
    SectionHeader();
    button({tr("market.gui.personal.sellItem")}, on: func () -> void {
        if (!navigateSellItem.value) [
            navigateSellItem.value = true;

            marketPersonal.close();
        ]
    }, sellItemOption);
    button({tr("market.gui.personal.sellItemContent")}, on: func () -> void {
        if (!navigateSellContent.value) [
            navigateSellContent.value = true;

            marketPersonal.close();
        ]
    }, sellItemContentOption);
    button({tr("market.gui.store.mine")}, on: func () -> void {
        if (!navigateStoreMine.value) [
            navigateStoreMine.value = true;

            marketPersonal.close();
        ]
    }, storeMineOption);
    button({tr("market.gui.personal.blacklist")}, on: func () -> void {
        if (!navigateBlacklist.value) [
            navigateBlacklist.value = true;

            marketPersonal.close();
        ]
    }, blacklistOption);
    closeButton();
    show(func (result) -> void {
        if (navigateStoreMine.value) [
            mineData = GUIManager::request("market.store.mine.has", []);
            mineForm = if (mineData[0]) [ "market.store.mine" : "market.store.create" ];

            GUIManager::open("market.store", mineForm, 1);
        :
            if (navigateSellItem.value) [
                GUIManager::switchTo("market.sell.inventory", 3);
            :
                if (navigateSellContent.value) [
                    checkData = GUIManager::request("market.sell.content.check", []);

                    if (checkData[0]) [
                        GUIManager::switchTo("market.sell.content", 3);
                    ]
                :
                    if (navigateBlacklist.value) [
                        GUIManager::switchTo("market.blacklist", 3);
                    ]
                ]
            ]
        ]
    });
    show();
};

sellInventory = new PaginatedForm("market.sell.inventory", {tr("market.gui.title")}, GUIManager::value("market.sell.inventory"), 10) {
    label({tr("market.gui.sell.item.dropdown")}, new TextOptions());
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            slotData = GUIManager::request("market.sell.slot", [ result.selectionIndex ]);

            buildSellItem(slotData[0]);
        :
            GUIManager::open("market", "market.personal", 1);
        ]
    });
    show();
};

sellContent = new PaginatedForm("market.sell.content", {tr("market.gui.title")}, GUIManager::value("market.my.items"), 10) {
    label({tr("market.gui.label")}, new TextOptions());
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            idData = GUIManager::request("market.my.item.id", [ result.selectionIndex ]);

            buildItemContent(idData[0]);
        :
            GUIManager::open("market", "market.personal", 1);
        ]
    });
    show();
};

navigateBlacklistAdd = new GlobalValue();
navigateBlacklistAdd.value = false;

blacklistAddOption = new ButtonOptions();
blacklistAddOption.tooltip = {tr("market.gui.sell.blacklist.add.tooltip")};

blacklist = new PaginatedForm("market.blacklist", {tr("market.gui.title")}, GUIManager::value("market.blacklists"), 10) {
    label({tr("market.gui.label")}, new TextOptions());
    PageControls();
    closeButton();
    divider(new DividerOptions());
    button({tr("market.gui.sell.blacklist.add")}, on: func () -> void {
        if (!navigateBlacklistAdd.value) [
            navigateBlacklistAdd.value = true;

            blacklist.close();
        ]
    }, blacklistAddOption);
    show(func (result) -> void {
        if (navigateBlacklistAdd.value) [
            checkData = GUIManager::request("market.blacklist.check", []);

            if (checkData[0]) [
                GUIManager::switchTo("market.blacklist.add", 3);
            ]
        :
            if (result.selection != "") [
                buildBlacklistSet(result.selection);
            :
                GUIManager::open("market", "market.personal", 1);
            ]
        ]
    });
    show();
};

blacklistAdd = new PaginatedForm("market.blacklist.add", {tr("market.gui.title")}, GUIManager::value("market.players"), 10) {
    label({tr("market.gui.sell.blacklist.add.label")}, new TextOptions());
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            uuidData = GUIManager::request("market.players.uuid", [ result.selectionIndex ]);
            addResult = GUIManager::request("market.blacklist.add", [ uuidData[0] ]);

            if (!addResult[0]) [
                GUIManager::open("market", "market.blacklist", 3);
            ]
        :
            GUIManager::open("market", "market.blacklist", 3);
        ]
    });
    show();
};

func buildItemInfo(id: string) -> void {
    itemInfoData = GUIManager::request("market.item.info", [ id ]);

    buyDone = new GlobalValue();
    buyDone.value = false;

    buyResult = new GlobalValue();
    buyResult.value = true;

    offshelfDone = new GlobalValue();
    offshelfDone.value = false;

    itemInfo = new CustomForm("market.item", {tr("market.gui.title")}) {
        label(itemInfoData[0], new TextOptions());
        SectionHeader();
        button({tr("market.gui.sell.item.button1")}, on: func () -> void {
            buyResultData = GUIManager::request("market.buy.submit", [ id ]);

            buyResult.value = buyResultData[0];
            buyDone.value = true;

            itemInfo.close();
        }, buyItemOption);

        if (GUIManager::request("market.isAdmin", [])[0]) [
            button({tr("market.gui.sell.item.button2")}, on: func () -> void {
                GUIManager::request("market.item.offshelf", [ id ]);

                offshelfDone.value = true;

                itemInfo.close();
            }, delistItemOption);
        ]

        closeButton();
        show(func (result) -> void {
            if (buyDone.value) [
                if (!buyResult.value) [
                    GUIManager::open("market", "market.buy", 3);
                ]
            :
                if (!offshelfDone.value) [
                    GUIManager::open("market", "market.buy", 3);
                ]
            ]
        });
    };

    GUIManager::switchTo("market.item", 1);
}

func buildItemContent(id: string) -> void {
    itemInfoData = GUIManager::request("market.item.info", [ id ]);

    offshelfReturnDone = new GlobalValue();
    offshelfReturnDone.value = false;

    itemMine = new CustomForm("market.item.mine", {tr("market.gui.title")}) {
        label(itemInfoData[0], new TextOptions());
        SectionHeader();
        button({tr("market.gui.sell.item.button2")}, on: func () -> void {
            GUIManager::request("market.item.offshelf.return", [ id ]);

            offshelfReturnDone.value = true;

            itemMine.close();
        }, delistItemOption);
        closeButton();
        show(func (result) -> void {
            if (!offshelfReturnDone.value) [
                GUIManager::open("market", "market.sell.content", 3);
            ]
        });
    };

    GUIManager::switchTo("market.item.mine", 1);
}

func buildSellItem(slot: int) -> void {
    itemName = new ObservableString("", true);
    itemIcon = new ObservableString("", true);
    itemIntroduce = new ObservableString("", true);
    itemScore = new ObservableString("", true);

    itemNameOptions = new TextFieldOptions();
    itemNameOptions.description = {tr("market.gui.sell.sellItem.input1.placeholder")};

    itemIconOptions = new TextFieldOptions();
    itemIconOptions.description = {tr("market.gui.sell.sellItem.input2.placeholder")};

    itemIntroduceOptions = new TextFieldOptions();
    itemIntroduceOptions.description = {tr("market.gui.sell.sellItem.input3.placeholder")};

    itemScoreOptions = new TextFieldOptions();
    itemScoreOptions.description = {tr("market.gui.sell.sellItem.input4.placeholder")};

    sellDone = new GlobalValue();
    sellDone.value = false;

    sellResult = new GlobalValue();
    sellResult.value = true;

    sellItemForm = new CustomForm("market.sell.item", {tr("market.gui.title")}) {
        label({tr("market.gui.label")}, new TextOptions());
        SectionHeader();
        textField({tr("market.gui.sell.sellItem.input1")}, itemName, itemNameOptions);
        textField({tr("market.gui.sell.sellItem.input2")}, itemIcon, itemIconOptions);
        textField({tr("market.gui.sell.sellItem.input3")}, itemIntroduce, itemIntroduceOptions);
        textField({tr("market.gui.sell.sellItem.input4")}, itemScore, itemScoreOptions);
        ConfirmBar(saveLabel(), func () -> void {
            sellResultData = GUIManager::request("market.sell.submit", [ slot, itemName.getData(), itemIcon.getData(), itemIntroduce.getData(), itemScore.getData() ]);

            sellResult.value = sellResultData[0];
            sellDone.value = true;

            sellItemForm.close();
        });
        show(func (result) -> void {
            if (!sellDone.value) [
                GUIManager::open("market", "market.sell.inventory", 3);
            :
                if (!sellResult.value) [
                    GUIManager::open("market", "market.sell.inventory", 3);
                ]
            ]
        });
    };

    GUIManager::switchTo("market.sell.item", 1);
}

func buildTradeType(uuid: string) -> void {
    typeIndex = new ObservableNumber(0.0, true);

    typeSell = new DropdownItem();
    typeSell.label = "sell";
    typeSell.value = 0;

    typeBuy = new DropdownItem();
    typeBuy.label = "buy";
    typeBuy.value = 1;

    typeItems = [ typeSell, typeBuy ];

    typeDone = new GlobalValue();
    typeDone.value = false;

    tradeType = new CustomForm("market.trade.type", {tr("market.gui.title")}) {
        label({tr("market.gui.label")}, new TextOptions());
        SectionHeader();
        dropdown({tr("market.gui.trade.dropdown")}, typeIndex, typeItems, new DropdownOptions());
        ConfirmBar(saveLabel(), func () -> void {
            typeDone.value = true;

            tradeType.close();
        });
        show(func (result) -> void {
            if (typeDone.value) [
                if (typeIndex.getData() == 0) [
                    GUIManager::callback("market.trade.request", [ uuid, "sell" ]);
                :
                    GUIManager::callback("market.trade.request", [ uuid, "buy" ]);
                ]
            :
                GUIManager::open("market", "market.open", 1);
            ]
        });
    };

    GUIManager::switchTo("market.trade.type", 1);
}

func buildBlacklistSet(id: string) -> void {
    infoData = GUIManager::request("market.blacklist.info", [ id ]);

    removeDone = new GlobalValue();
    removeDone.value = false;

    blacklistInfo = new CustomForm("market.blacklist.info", {tr("market.gui.title")}) {
        label(infoData[0], new TextOptions());
        SectionHeader();
        ConfirmBar({tr("market.gui.sell.blacklist.set.remove")}, func () -> void {
            GUIManager::callback("market.blacklist.remove", [ id ]);

            removeDone.value = true;

            blacklistInfo.close();
        });
        show(func (result) -> void {
            if (!removeDone.value) [
                GUIManager::open("market", "market.blacklist", 3);
            ]
        });
    };

    GUIManager::switchTo("market.blacklist.info", 1);
}
