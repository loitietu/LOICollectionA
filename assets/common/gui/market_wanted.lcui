import "generic.lcui";

navigateWantedCreate = new GlobalValue();
navigateWantedCreate.value = false;

navigateWantedMine = new GlobalValue();
navigateWantedMine.value = false;

createOption = new ButtonOptions();
createOption.tooltip = {tr("market.gui.wanted.create.tooltip")};

mineOption = new ButtonOptions();
mineOption.tooltip = {tr("market.gui.wanted.mine.tooltip")};

wanted = new PaginatedForm("market.wanted", {tr("market.gui.title")}, GUIManager::value("market.wanted.items"), 10) {
    label({tr("market.gui.wanted.list.label")}, new TextOptions());
    SectionHeader();
    PageControls();
    divider(new DividerOptions());
    button({tr("market.gui.wanted.create")}, on: func () -> void {
        if (!navigateWantedCreate.value) [
            navigateWantedCreate.value = true;

            wanted.close();
        ]
    }, createOption);
    button({tr("market.gui.wanted.mine")}, on: func () -> void {
        if (!navigateWantedMine.value) [
            navigateWantedMine.value = true;

            wanted.close();
        ]
    }, mineOption);
    closeButton();
    show(func (result) -> void {
        if (navigateWantedCreate.value) [
            buildWantedInventory();
            return;
        ]

        if (navigateWantedMine.value) [
            buildWantedMine();
            return;
        ]

        if (result.selection != "") [
            idData = GUIManager::request("market.wanted.id", [ result.selectionIndex ]);

            buildWantedInfo(idData[0]);
        :
            GUIManager::open("market", "market.open", 1);
        ]
    });
    show();
};

func buildWantedInfo(id: string) -> void {
    infoData = GUIManager::request("market.wanted.info", [ id ]);

    fillAmount = new ObservableString("", true);

    fillOptions = new TextFieldOptions();
    fillOptions.description = {tr("market.gui.wanted.fill.amount.placeholder")};

    fillDone = new GlobalValue();
    fillDone.value = false;

    fillResult = new GlobalValue();
    fillResult.value = true;

    wantedInfo = new CustomForm("market.wanted.info", {tr("market.gui.title")}) {
        label(infoData[0], new TextOptions());
        SectionHeader();
        textField({tr("market.gui.wanted.fill.amount")}, fillAmount, fillOptions);
        ConfirmBar({tr("market.gui.wanted.fill")}, func () -> void {
            fillResultData = GUIManager::request("market.wanted.fill.submit", [ id, fillAmount.getData() ]);

            fillResult.value = fillResultData[0];
            fillDone.value = true;

            wantedInfo.close();
        });
        show(func (result) -> void {
            if (fillDone.value) [
                if (fillResult.value) [
                    GUIManager::open("market.wanted", "market.wanted", 3);
                :
                    GUIManager::open("market.wanted", "market.wanted", 3);
                ]
            :
                GUIManager::open("market.wanted", "market.wanted", 3);
            ]
        });
    };

    GUIManager::switchTo("market.wanted.info", 1);
}

func buildWantedInventory() -> void {
    wantedInventory = new PaginatedForm("market.wanted.inventory", {tr("market.gui.title")}, GUIManager::value("market.sell.inventory"), 10) {
        label({tr("market.gui.sell.item.dropdown")}, new TextOptions());
        SectionHeader();
        PageControls();
        closeButton();
        show(func (result) -> void {
            if (result.selection != "") [
                slotData = GUIManager::request("market.wanted.slot", [ result.selectionIndex ]);

                buildWantedCreate(slotData[0]);
            :
                GUIManager::open("market.wanted", "market.wanted", 3);
            ]
        });
    };

    GUIManager::switchTo("market.wanted.inventory", 3);
}

func buildWantedCreate(slot: int) -> void {
    wantedName = new ObservableString("", true);
    wantedPrice = new ObservableString("", true);
    wantedAmount = new ObservableString("", true);

    nameOptions = new TextFieldOptions();
    nameOptions.description = {tr("market.gui.wanted.create.name.placeholder")};

    priceOptions = new TextFieldOptions();
    priceOptions.description = {tr("market.gui.wanted.create.price.placeholder")};

    amountOptions = new TextFieldOptions();
    amountOptions.description = {tr("market.gui.wanted.create.amount.placeholder")};

    createDone = new GlobalValue();
    createDone.value = false;

    createResult = new GlobalValue();
    createResult.value = true;

    wantedCreate = new CustomForm("market.wanted.create", {tr("market.gui.title")}) {
        label({tr("market.gui.label")}, new TextOptions());
        SectionHeader();
        textField({tr("market.gui.wanted.create.name")}, wantedName, nameOptions);
        textField({tr("market.gui.wanted.create.price")}, wantedPrice, priceOptions);
        textField({tr("market.gui.wanted.create.amount")}, wantedAmount, amountOptions);
        ConfirmBar(saveLabel(), func () -> void {
            createResultData = GUIManager::request("market.wanted.create.submit", [ slot, wantedName.getData(), wantedPrice.getData(), wantedAmount.getData() ]);

            createResult.value = createResultData[0];
            createDone.value = true;

            wantedCreate.close();
        });
        show(func (result) -> void {
            if (createDone.value) [
                if (createResult.value) [
                    GUIManager::open("market.wanted", "market.wanted", 3);
                :
                    GUIManager::open("market.wanted", "market.wanted", 3);
                ]
            :
                GUIManager::open("market.wanted", "market.wanted", 3);
            ]
        });
    };

    GUIManager::switchTo("market.wanted.create", 1);
}

func buildWantedMine() -> void {
    wantedMine = new PaginatedForm("market.wanted.mine", {tr("market.gui.title")}, GUIManager::value("market.my.wanted"), 10) {
        label({tr("market.gui.wanted.mine.label")}, new TextOptions());
        SectionHeader();
        PageControls();
        closeButton();
        show(func (result) -> void {
            if (result.selection != "") [
                idData = GUIManager::request("market.my.wanted.id", [ result.selectionIndex ]);

                buildWantedCancel(idData[0]);
            :
                GUIManager::open("market.wanted", "market.wanted", 3);
            ]
        });
    };

    GUIManager::switchTo("market.wanted.mine", 3);
}

func buildWantedCancel(id: string) -> void {
    infoData = GUIManager::request("market.wanted.info", [ id ]);

    cancelDone = new GlobalValue();
    cancelDone.value = false;

    cancelResult = new GlobalValue();
    cancelResult.value = true;

    wantedCancel = new CustomForm("market.wanted.cancel", {tr("market.gui.title")}) {
        label(infoData[0], new TextOptions());
        SectionHeader();
        ConfirmBar({tr("market.gui.wanted.cancel")}, func () -> void {
            cancelResultData = GUIManager::request("market.wanted.cancel.submit", [ id ]);

            cancelResult.value = cancelResultData[0];
            cancelDone.value = true;

            wantedCancel.close();
        });
        show(func (result) -> void {
            if (cancelDone.value) [
                if (cancelResult.value) [
                    GUIManager::open("market.wanted", "market.wanted", 3);
                :
                    GUIManager::open("market.wanted", "market.wanted.mine", 3);
                ]
            :
                GUIManager::open("market.wanted", "market.wanted.mine", 3);
            ]
        });
    };

    GUIManager::switchTo("market.wanted.cancel", 1);
}
