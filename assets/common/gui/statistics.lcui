import "generic.lcui";

pendingStatistic = new CtxValue(0);

if (pendingStatistic.value != "") [
    rankingData = GUIManager::request("statistics.ranking", [ pendingStatistic.value ]);

    specific = new CustomForm("statistics.specific", {tr("statistics.gui.title")}) {
        label(std::format({tr("statistics.gui.specific.label")}, [ rankingData[0], rankingData[1] ]), new TextOptions());
        label(rankingData[2], new TextOptions());
        SectionHeader();
        closeButton();
        show(func (result) -> void {
            GUIManager::open("statistics", "statistics.open", 3, [ "" ]);
        });
    };
]

open = new PaginatedForm("statistics.open", {tr("statistics.gui.title")}, GUIManager::value("statistics.names"), 10) {
    label({tr("statistics.gui.label")}, new TextOptions());
    SectionHeader();
    PageControls();
    closeButton();
    show(func (result) -> void {
        if (result.selection != "") [
            rankingData = GUIManager::request("statistics.ranking", [ result.selection ]);

            specific = new CustomForm("statistics.specific", {tr("statistics.gui.title")}) {
                label(std::format({tr("statistics.gui.specific.label")}, [ rankingData[0], rankingData[1] ]), new TextOptions());
                label(rankingData[2], new TextOptions());
                SectionHeader();
                closeButton();
                show(func (result) -> void {
                    GUIManager::open("statistics", "statistics.open", 3, [ "" ]);
                });
            };

            GUIManager::switchTo("statistics.specific", 1);
        ]
    });
};
