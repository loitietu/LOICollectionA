/* Std: eager array helpers (Rust slice/Vec inspired).
 *
 * Built on the native Array value methods (.push() / .pop() / .length() /
 * .slice() / .sort() / .contains() / .indexOf() / .join()) and for-in.
 * Functions taking a mapper or predicate expect an Fn1/Fn2 subclass from
 * iter.lcui.
 */

import "iter.lcui" { Fn1, Fn2 };
import "map.lcui" { mapNew, mapHas, mapGet, mapSet, mapSize, mapKeys };

/* arrMap applies f to every element, returning a new array. */
func arrMap(a, f: Fn1) {
    let out = [];
    for (v in a) [
        out.push(f.call(v));
    ]
    return out;
}

/* arrFilter keeps only the elements where pred returns true. */
func arrFilter(a, pred: Fn1) {
    let out = [];
    for (v in a) [
        if (pred.call(v)) [ out.push(v); ]
    ]
    return out;
}

/* arrReverse returns the elements in reverse order. */
func arrReverse(a) {
    let out = [];
    let i = a.length() - 1;
    while (i >= 0) [
        out.push(a[i]);
        i = i - 1;
    ]
    return out;
}

/* arrSum returns the arithmetic sum of all elements (0 for empty). */
func arrSum(a) {
    let total = 0;
    for (v in a) [
        total = total + v;
    ]
    return total;
}

/* arrProduct returns the product of all elements (1 for empty). */
func arrProduct(a) {
    let total = 1;
    for (v in a) [
        total = total * v;
    ]
    return total;
}

/* arrAny returns true if any element satisfies pred. */
func arrAny(a, pred: Fn1) -> bool {
    for (v in a) [
        if (pred.call(v)) [ return true; ]
    ]
    return false;
}

/* arrAll returns true if every element satisfies pred. */
func arrAll(a, pred: Fn1) -> bool {
    for (v in a) [
        if (!pred.call(v)) [ return false; ]
    ]
    return true;
}

/* arrFind returns the first match, or None when nothing matched. */
func arrFind(a, pred: Fn1) {
    for (v in a) [
        if (pred.call(v)) [ return v; ]
    ]
    return None;
}

/* arrFindIndex returns the first matching position, or -1. */
func arrFindIndex(a, pred: Fn1) -> int {
    let i = 0;
    while (i < a.length()) [
        if (pred.call(a[i])) [ return i; ]
        i = i + 1;
    ]
    return -1;
}

/* arrDedup removes duplicate elements, preserving first-seen order. */
func arrDedup(a) {
    let out = [];
    for (v in a) [
        if (!out.contains(v)) [ out.push(v); ]
    ]
    return out;
}

/* arrZip pairs elements of a and b as [x, y] arrays, stopping at the
 * shorter input. */
func arrZip(a, b) {
    let out = [];
    let n = a.length();
    if (b.length() < n) [ n = b.length(); ]
    let i = 0;
    while (i < n) [
        out.push([a[i], b[i]]);
        i = i + 1;
    ]
    return out;
}

/* arrLast returns the final element, or None for an empty array. */
func arrLast(a) {
    if (a.length() == 0) [ return None; ]
    return a[a.length() - 1];
}

/* arrChunk splits the array into consecutive chunks of at most `size`. */
func arrChunk(a, size: int) {
    let out = [];
    let cur = [];
    let i = 0;
    while (i < a.length()) [
        cur.push(a[i]);
        if (cur.length() >= size) [
            out.push(cur);
            cur = [];
        ]
        i = i + 1;
    ]
    if (cur.length() > 0) [ out.push(cur); ]
    return out;
}

/* arrFirst returns the first element, or None for an empty array. */
func arrFirst(a) {
    if (a.length() == 0) [ return None; ]
    return a[0];
}

/* arrFlatten concatenates one level of nested arrays. */
func arrFlatten(a) {
    let out = [];
    for (v in a) [
        for (x in v) [
            out.push(x);
        ]
    ]
    return out;
}

/* arrFlatMap applies f to every element and flattens the results one level. */
func arrFlatMap(a, f: Fn1) {
    let out = [];
    for (v in a) [
        let mapped = f.call(v);
        for (x in mapped) [
            out.push(x);
        ]
    ]
    return out;
}

/* arrTake returns the first n elements (or all of them when shorter). */
func arrTake(a, n: int) {
    let out = [];
    let i = 0;
    while (i < n && i < a.length()) [
        out.push(a[i]);
        i = i + 1;
    ]
    return out;
}

/* arrSkip returns the elements after the first n. */
func arrSkip(a, n: int) {
    let out = [];
    let i = n;
    while (i < a.length()) [
        out.push(a[i]);
        i = i + 1;
    ]
    return out;
}

/* arrConcat returns a new array holding a followed by b. */
func arrConcat(a, b) {
    let out = [];
    for (v in a) [
        out.push(v);
    ]
    for (v in b) [
        out.push(v);
    ]
    return out;
}

/* arrCount returns how many elements satisfy pred. */
func arrCount(a, pred: Fn1) -> int {
    let total = 0;
    for (v in a) [
        if (pred.call(v)) [ total = total + 1; ]
    ]
    return total;
}

/* arrReduce folds a left-to-right from `seed` via f(acc, v). */
func arrReduce(a, f: Fn2, seed) {
    let acc = seed;
    for (v in a) [
        acc = f.call(acc, v);
    ]
    return acc;
}

/* arrMin returns the smallest element, or None when empty. */
func arrMin(a) {
    if (a.length() == 0) [ return None; ]
    let best = a[0];
    for (v in a) [
        if (v < best) [ best = v; ]
    ]
    return best;
}

/* arrMax returns the largest element, or None when empty. */
func arrMax(a) {
    if (a.length() == 0) [ return None; ]
    let best = a[0];
    for (v in a) [
        if (v > best) [ best = v; ]
    ]
    return best;
}

/* arrMean returns the arithmetic average, or 0 for an empty array. */
func arrMean(a) {
    if (a.length() == 0) [ return 0; ]
    let total = 0;
    for (v in a) [
        total = total + v;
    ]
    return total / a.length();
}

/* arrSortBy orders a copy of a by the key returned by f (stable). */
func arrSortBy(a, f: Fn1) {
    let out = [];
    for (v in a) [
        out.push(v);
    ]

    let i = 1;
    while (i < out.length()) [
        let cur = out[i];
        let curKey = f.call(cur);
        let j = i - 1;
        while (j >= 0 && f.call(out[j]) > curKey) [
            out[j + 1] = out[j];
            j = j - 1;
        ]
        out[j + 1] = cur;
        i = i + 1;
    ]
    return out;
}

/* arrGroupBy buckets the elements by the key returned from f, keyed by the
 * text form of that key. */
func arrGroupBy(a, f: Fn1) {
    let out = mapNew();
    for (v in a) [
        let k = "" + f.call(v);
        if (mapHas(out, k)) [
            let bucket = mapGet(out, k);
            bucket.push(v);
            mapSet(out, k, bucket);
        :
            let fresh = [];
            fresh.push(v);
            mapSet(out, k, fresh);
        ]
    ]
    return out;
}

/* arrPartition splits a into [matching, nonMatching] according to pred. */
func arrPartition(a, pred: Fn1) {
    let yes = [];
    let no = [];
    for (v in a) [
        if (pred.call(v)) [ yes.push(v); : no.push(v); ]
    ]
    return [yes, no];
}

/* arrWindow returns every consecutive run of `size` elements. */
func arrWindow(a, size: int) {
    let out = [];
    if (size <= 0) [ return out; ]

    let i = 0;
    while (i + size <= a.length()) [
        let win = [];
        let j = 0;
        while (j < size) [
            win.push(a[i + j]);
            j = j + 1;
        ]
        out.push(win);
        i = i + 1;
    ]
    return out;
}

/* arrUnion returns the elements of a and b with duplicates removed. */
func arrUnion(a, b) {
    let out = [];
    for (v in a) [
        if (!out.contains(v)) [ out.push(v); ]
    ]
    for (v in b) [
        if (!out.contains(v)) [ out.push(v); ]
    ]
    return out;
}

/* arrIntersect returns the elements present in both a and b. */
func arrIntersect(a, b) {
    let out = [];
    for (v in a) [
        if (b.contains(v) && !out.contains(v)) [ out.push(v); ]
    ]
    return out;
}

/* arrDifference returns the elements of a that are absent from b. */
func arrDifference(a, b) {
    let out = [];
    for (v in a) [
        if (!b.contains(v) && !out.contains(v)) [ out.push(v); ]
    ]
    return out;
}

/* arrFill returns an array of n copies of v. */
func arrFill(n: int, v) {
    let out = [];
    let i = 0;
    while (i < n) [
        out.push(v);
        i = i + 1;
    ]
    return out;
}

/* arrRange returns the integers in [from, to). */
func arrRange(from: int, to: int) {
    let out = [];
    let i = from;
    while (i < to) [
        out.push(i);
        i = i + 1;
    ]
    return out;
}

/* arrEqual reports whether a and b hold the same elements in the same order. */
func arrEqual(a, b) -> bool {
    if (a.length() != b.length()) [ return false; ]

    let i = 0;
    while (i < a.length()) [
        if (a[i] != b[i]) [ return false; ]
        i = i + 1;
    ]
    return true;
}

/* arrIsEmpty reports whether a has no elements. */
func arrIsEmpty(a) -> bool {
    return a.length() == 0;
}

/* arrIndexOfValue returns the first position of v in a, or -1. */
func arrIndexOfValue(a, v) -> int {
    let i = 0;
    while (i < a.length()) [
        if (a[i] == v) [ return i; ]
        i = i + 1;
    ]
    return -1;
}

/* arrRotate returns the elements shifted left by n (negative shifts right). */
func arrRotate(a, n: int) {
    let out = [];
    let len = a.length();
    if (len == 0) [ return out; ]

    let shift = n;
    while (shift < 0) [
        shift = shift + len;
    ]

    let i = 0;
    while (i < len) [
        out.push(a[(i + shift) % len]);
        i = i + 1;
    ]
    return out;
}

/* arrShuffle returns a randomly permuted copy of a. */
func arrShuffle(a) {
    let out = [];
    for (v in a) [
        out.push(v);
    ]

    let i = out.length() - 1;
    while (i > 0) [
        let j = math::random(0, i);
        let tmp = out[i];
        out[i] = out[j];
        out[j] = tmp;
        i = i - 1;
    ]
    return out;
}

/* arrInterleave alternates elements of a and b. */
func arrInterleave(a, b) {
    let out = [];
    let i = 0;
    while (i < a.length() || i < b.length()) [
        if (i < a.length()) [ out.push(a[i]); ]
        if (i < b.length()) [ out.push(b[i]); ]
        i = i + 1;
    ]
    return out;
}

/* arrIntersperse inserts sep between every pair of elements. */
func arrIntersperse(a, sep) {
    let out = [];
    let i = 0;
    while (i < a.length()) [
        if (i > 0) [ out.push(sep); ]
        out.push(a[i]);
        i = i + 1;
    ]
    return out;
}

/* arrUniqueBy keeps the first element for each key produced by f. */
func arrUniqueBy(a, f: Fn1) {
    let out = [];
    let seen = new Map();
    for (v in a) [
        let key = "" + f.call(v);
        if (!seen.has(key)) [ seen.set(key, true); out.push(v); ]
    ]
    return out;
}

/* arrZipWith combines paired elements with f. */
func arrZipWith(a, b, f: Fn2) {
    let out = [];
    let n = a.length();
    if (b.length() < n) [ n = b.length(); ]
    let i = 0;
    while (i < n) [ out.push(f.call(a[i], b[i])); i = i + 1; ]
    return out;
}

/* arrScan returns the running fold of a starting from seed. */
func arrScan(a, f: Fn2, seed) {
    let out = [seed];
    let acc = seed;
    for (v in a) [ acc = f.call(acc, v); out.push(acc); ]
    return out;
}

/* arrRemoveAt returns a without the element at index i. */
func arrRemoveAt(a, i: int) {
    let out = [];
    let j = 0;
    while (j < a.length()) [ if (j != i) [ out.push(a[j]); ] j = j + 1; ]
    return out;
}

/* arrInsertAt returns a with v inserted at index i. */
func arrInsertAt(a, i: int, v) {
    let out = [];
    let j = 0;
    while (j < a.length()) [
        if (j == i) [ out.push(v); ]
        out.push(a[j]);
        j = j + 1;
    ]
    if (i >= a.length()) [ out.push(v); ]
    return out;
}

/* arrSwap returns a copy with the elements at i and j exchanged. */
func arrSwap(a, i: int, j: int) {
    let out = [];
    for (v in a) [ out.push(v); ]
    let tmp = out[i];
    out[i] = out[j];
    out[j] = tmp;
    return out;
}

/* arrFrequencies returns a map of element -> occurrence count. */
func arrFrequencies(a) -> Map {
    let m = new Map();
    for (v in a) [
        let key = "" + v;
        if (m.has(key)) [ m.set(key, m.get(key) + 1); ]
        if (!m.has(key)) [ m.set(key, 1); ]
    ]
    return m;
}

/* arrMode returns the most frequent element, or None when empty. */
func arrMode(a) {
    let m = arrFrequencies(a);
    let best = None;
    let bestCount = 0;
    for (k in m) [
        let c = m.get(k);
        if (c > bestCount) [ bestCount = c; best = k.toInt(); ]
    ]
    return best;
}

/* arrVariance returns the population variance of a (0 for empty). */
func arrVariance(a) -> float {
    let n = a.length();
    if (n == 0) [ return 0.0; ]
    let mean = 0.0;
    for (v in a) [ mean = mean + v; ]
    mean = mean / (n * 1.0);
    let sumSq = 0.0;
    for (v in a) [ sumSq = sumSq + (v - mean) * (v - mean); ]
    return sumSq / (n * 1.0);
}

/* arrStdDev returns the population standard deviation of a. */
func arrStdDev(a) -> float {
    return math::sqrt(arrVariance(a));
}

/* arrCartesian returns every [x, y] pair from a and b. */
func arrCartesian(a, b) {
    let out = [];
    for (x in a) [ for (y in b) [ out.push([x, y]); ] ]
    return out;
}

/* arrSymmetricDifference returns elements present in exactly one of a, b. */
func arrSymmetricDifference(a, b) {
    let out = [];
    for (v in a) [ if (arrIndexOfValue(b, v) < 0) [ out.push(v); ] ]
    for (v in b) [ if (arrIndexOfValue(a, v) < 0) [ out.push(v); ] ]
    return out;
}

/* arrSorted returns a sorted copy of a without mutating it. */
func arrSorted(a) {
    let out = [];
    for (v in a) [ out.push(v); ]
    out.sort();
    return out;
}

/* arrCompact returns a without None elements. */
func arrCompact(a) {
    let out = [];
    for (v in a) [ if (v != None) [ out.push(v); ] ]
    return out;
}

/* arrPad extends a with v up to length n. */
func arrPad(a, n: int, v) {
    let out = [];
    for (x in a) [ out.push(x); ]
    while (out.length() < n) [ out.push(v); ]
    return out;
}

/* mapMapValues returns a map with every value transformed by f. */
func mapMapValues(m: Map, f: Fn1) -> Map {
    let out = new Map();
    for (k in m) [ out.set(k, f.call(m.get(k))); ]
    return out;
}

/* mapMapKeys returns a map with every key transformed by f. */
func mapMapKeys(m: Map, f: Fn1) -> Map {
    let out = new Map();
    for (k in m) [ out.set("" + f.call(k), m.get(k)); ]
    return out;
}

/* mapFilter keeps only entries whose value satisfies pred. */
func mapFilter(m: Map, pred: Fn2) -> Map {
    let out = new Map();
    for (k in m) [ if (pred.call(k, m.get(k))) [ out.set(k, m.get(k)); ] ]
    return out;
}

/* mapFromArray builds a map from items via keyFn and valFn. */
func mapFromArray(a, keyFn: Fn1, valFn: Fn1) -> Map {
    let out = new Map();
    for (item in a) [ out.set("" + keyFn.call(item), valFn.call(item)); ]
    return out;
}

/* mapKeysWhere returns the keys whose value satisfies pred. */
func mapKeysWhere(m: Map, pred: Fn1) {
    let out = [];
    for (k in m) [ if (pred.call(m.get(k))) [ out.push(k); ] ]
    return out;
}

/* mapForEach invokes f for every [key, value] pair. */
func mapForEach(m: Map, f: Fn2) {
    for (k in m) [ f.call(k, m.get(k)); ]
}

/* mapUpdate applies f to the value stored under k, in place. */
func mapUpdate(m: Map, k, f: Fn1) -> Map {
    if (m.has(k)) [ m.set(k, f.call(m.get(k))); ]
    return m;
}

/* setMap returns a new set with f applied to every member. */
func setMap(s: Map, f: Fn1) -> Map {
    let out = new Map();
    for (k in s) [ out.set("" + f.call(k.toInt()), true); ]
    return out;
}

/* setFilter returns a new set keeping members where pred holds. */
func setFilter(s: Map, pred: Fn1) -> Map {
    let out = new Map();
    for (k in s) [ if (pred.call(k.toInt())) [ out.set(k, true); ] ]
    return out;
}

/* setCount returns the number of members satisfying pred. */
func setCount(s: Map, pred: Fn1) -> int {
    let n = 0;
    for (k in s) [ if (pred.call(k.toInt())) [ n = n + 1; ] ]
    return n;
}
