/* Std: Result — a recoverable error type built on the language's native
 * tagged unions instead of a class with a flag.
 *
 *     import "/result.lcui";
 *
 *     let r = Ok(42);
 *     match (r) [ Ok(v) [ println("got " + v) ] Err(e) [ println("failed: " + e) ] ]
 *
 * Ok(v) wraps a success payload and Err(e) an error message. The helpers below
 * operate on either variant; resultMap and resultAndThen take a closure (or an
 * Fn1 subclass) and forward the payload with f.call(...).
 *
 * Migration note: this module used to be `class Result` with an `ok` flag and
 * `Result.Ok(v)` / `r.unwrap()` methods. The native enum encodes the same
 * states in the tag, so the flag and the boxing object are both gone — use
 * `Ok(v)` / `Err(e)` and the result* helpers, or destructure with
 * `match` / `if let`.
 */

enum Result {
    Ok(int)
    Err(string)
}

/* resultIsOk reports whether r is an Ok. */
func resultIsOk(r: Result) -> bool {
    if (let Ok(v) = r) [ return true; ]
    return false;
}

/* resultIsErr reports whether r is an Err. */
func resultIsErr(r: Result) -> bool {
    return !resultIsOk(r);
}

/* resultUnwrap returns the Ok payload, panicking on an Err. */
func resultUnwrap(r: Result) {
    if (let Ok(v) = r) [ return v; ]
    panic("unwrap on Err");
}

/* resultUnwrapOr returns the Ok payload, or fallback on an Err. */
func resultUnwrapOr(r: Result, fallback) {
    if (let Ok(v) = r) [ return v; ]
    return fallback;
}

/* resultExpect returns the Ok payload, panicking with msg on an Err. */
func resultExpect(r: Result, msg) {
    if (let Ok(v) = r) [ return v; ]
    panic(msg);
}

/* resultErrOr returns the Err message, or fallback on an Ok. */
func resultErrOr(r: Result, fallback) {
    if (let Err(e) = r) [ return e; ]
    return fallback;
}

/* resultMap applies f to an Ok payload, passing an Err through untouched. */
func resultMap(r: Result, f) {
    if (let Ok(v) = r) [ return Ok(f.call(v)); ]
    return r;
}

/* resultMapErr applies f to an Err message, passing an Ok through untouched. */
func resultMapErr(r: Result, f) {
    if (let Err(e) = r) [ return Err(f.call(e)); ]
    return r;
}

/* resultAndThen chains a follow-up operation that itself returns a Result. */
func resultAndThen(r: Result, f) {
    if (let Ok(v) = r) [ return f.call(v); ]
    return r;
}
