/* Std: string helpers, replacing the former `string::` native namespace.
 *
 * Everything here is plain script on top of the String value methods
 * (.length() / .indexOf() / .split() / .contains() / .startsWith() /
 * .endsWith() / .toInt() / .toFloat()) and Unicode-aware char iteration.
 *
 * upper/lower map ASCII letters, exactly like the removed native
 * implementation; non-letters pass through unchanged.
 */

/* length returns the number of Unicode characters in s. */
func length(s) {
    return s.length();
}

/* charAt returns the character at index i, or "" if out of range. */
func charAt(s, i) {
    for (j, c in s) [
        if (j == i) [ return c; ]
    ]
    return "";
}

/* isSpace reports whether c is a space, tab, newline or carriage return. */
func isSpace(c) -> bool {
    return c == " " || c == "\t" || c == "\n" || c == "\r";
}

/* slice(s, start, end) keeps chars in [start, end). */
func slice(s, start: int, end: int) {
    let out = "";
    let i = 0;
    for (c in s) [
        if (i >= start && i < end) [ out = out + c; ]
        i = i + 1;
    ]
    return out;
}

/* substr(s, start, count) keeps `count` chars beginning at `start`. */
func substr(s, start: int, count: int) {
    return slice(s, start, start + count);
}

/* upper returns s with ASCII letters upper-cased; other chars pass through. */
func upper(s) {
    let low = "abcdefghijklmnopqrstuvwxyz";
    let up = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    let out = "";
    for (c in s) [
        let p = low.indexOf(c);
        let mapped = c;
        if (p >= 0) [ mapped = charAt(up, p); ]
        out = out + mapped;
    ]
    return out;
}

/* lower returns s with ASCII letters lower-cased; other chars pass through. */
func lower(s) {
    let low = "abcdefghijklmnopqrstuvwxyz";
    let up = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    let out = "";
    for (c in s) [
        let p = up.indexOf(c);
        let mapped = c;
        if (p >= 0) [ mapped = charAt(low, p); ]
        out = out + mapped;
    ]
    return out;
}

/* capitalize upper-cases the first character and keeps the rest unchanged. */
func capitalize(s) {
    if (s.length() == 0) [ return s; ]
    return upper(charAt(s, 0)) + substr(s, 1, s.length() - 1);
}

/* trim strips leading and trailing whitespace from s. */
func trim(s) {
    let start = 0;
    let end = s.length();
    while (start < end && isSpace(charAt(s, start))) [
        start = start + 1;
    ]
    while (end > start && isSpace(charAt(s, end - 1))) [
        end = end - 1;
    ]
    return slice(s, start, end);
}

/* startsWithAt reports whether needle occurs at index `at` in s. */
func startsWithAt(s, needle, at: int) -> bool {
    let k = 0;
    let m = needle.length();
    while (k < m) [
        if (charAt(s, at + k) != charAt(needle, k)) [ return false; ]
        k = k + 1;
    ]
    return true;
}

/* replace replaces every occurrence of `from` with `to`. */
func replace(s, from, to) {
    if (from.length() == 0) [ return s; ]
    let out = "";
    let i = 0;
    let n = s.length();
    let m = from.length();
    while (i < n) [
        if (startsWithAt(s, from, i)) [
            out = out + to;
            i = i + m;
        :
            out = out + charAt(s, i);
            i = i + 1;
        ]
    ]
    return out;
}

/* repeat concatenates s `times` times (empty result when times <= 0). */
func repeat(s, times: int) {
    let out = "";
    let i = 0;
    while (i < times) [
        out = out + s;
        i = i + 1;
    ]
    return out;
}

/* padLeft left-pads s with `pad` until its length reaches `width`. */
func padLeft(s, width: int, pad) {
    let out = s;
    while (out.length() < width) [
        out = pad + out;
    ]
    return out;
}

/* padRight right-pads s with `pad` until its length reaches `width`. */
func padRight(s, width: int, pad) {
    let out = s;
    while (out.length() < width) [
        out = out + pad;
    ]
    return out;
}

/* reverse returns the characters of s in reverse order. */
func reverse(s) {
    let out = "";
    for (c in s) [
        out = c + out;
    ]
    return out;
}

/* trimStart strips leading whitespace from s. */
func trimStart(s) {
    let start = 0;
    let n = s.length();
    while (start < n && isSpace(charAt(s, start))) [
        start = start + 1;
    ]
    return slice(s, start, n);
}

/* trimEnd strips trailing whitespace from s. */
func trimEnd(s) {
    let end = s.length();
    while (end > 0 && isSpace(charAt(s, end - 1))) [
        end = end - 1;
    ]
    return slice(s, 0, end);
}

/* startsWith reports whether s begins with prefix. */
func startsWith(s, prefix) -> bool {
    return startsWithAt(s, prefix, 0);
}

/* endsWith reports whether s ends with suffix. */
func endsWith(s, suffix) -> bool {
    let at = s.length() - suffix.length();
    if (at < 0) [ return false; ]
    return startsWithAt(s, suffix, at);
}

/* contains reports whether needle occurs anywhere in s. */
func contains(s, needle) -> bool {
    return indexOf(s, needle) >= 0;
}

/* indexOf returns the first position of needle in s, or -1 when absent. */
func indexOf(s, needle) -> int {
    if (needle.length() == 0) [ return 0; ]
    let i = 0;
    let last = s.length() - needle.length();
    while (i <= last) [
        if (startsWithAt(s, needle, i)) [ return i; ]
        i = i + 1;
    ]
    return -1;
}

/* lastIndexOf returns the last position of needle in s, or -1 when absent. */
func lastIndexOf(s, needle) -> int {
    if (needle.length() == 0) [ return s.length(); ]
    let i = s.length() - needle.length();
    while (i >= 0) [
        if (startsWithAt(s, needle, i)) [ return i; ]
        i = i - 1;
    ]
    return -1;
}

/* count returns how many non-overlapping times needle occurs in s. */
func count(s, needle) -> int {
    if (needle.length() == 0) [ return 0; ]
    let total = 0;
    let i = 0;
    let last = s.length() - needle.length();
    while (i <= last) [
        if (startsWithAt(s, needle, i)) [
            total = total + 1;
            i = i + needle.length();
        :
            i = i + 1;
        ]
    ]
    return total;
}

/* split splits s on every occurrence of sep, returning an array. */
func split(s, sep) {
    return s.split(sep);
}

/* join concatenates the elements of a, separated by sep. */
func join(a, sep) {
    return a.join(sep);
}

/* words splits s on runs of whitespace, dropping empty entries. */
func words(s) {
    let out = [];
    let cur = "";
    for (c in s) [
        if (isSpace(c)) [
            if (cur.length() > 0) [ out.push(cur); ]
            cur = "";
        :
            cur = cur + c;
        ]
    ]
    if (cur.length() > 0) [ out.push(cur); ]
    return out;
}

/* lines splits s on newlines, dropping empty entries and trailing \r. */
func lines(s) {
    let out = [];
    let cur = "";
    for (c in s) [
        if (c == "\n") [
            if (cur.length() > 0) [ out.push(cur); ]
            cur = "";
        :
            if (c != "\r") [ cur = cur + c; ]
        ]
    ]
    if (cur.length() > 0) [ out.push(cur); ]
    return out;
}

/* isEmpty reports whether s has no characters. */
func isEmpty(s) -> bool {
    return s.length() == 0;
}

/* isBlank reports whether s is empty or made only of whitespace. */
func isBlank(s) -> bool {
    return trim(s).length() == 0;
}

/* isUpper reports whether c is a single ASCII upper-case letter. */
func isUpper(c) -> bool {
    if (c.length() != 1) [ return false; ]
    return indexOf("ABCDEFGHIJKLMNOPQRSTUVWXYZ", c) >= 0;
}

/* isLower reports whether c is a single ASCII lower-case letter. */
func isLower(c) -> bool {
    if (c.length() != 1) [ return false; ]
    return indexOf("abcdefghijklmnopqrstuvwxyz", c) >= 0;
}

/* isDigit reports whether c is a single ASCII decimal digit. */
func isDigit(c) -> bool {
    if (c.length() != 1) [ return false; ]
    return indexOf("0123456789", c) >= 0;
}

/* isAlpha reports whether c is an ASCII letter. */
func isAlpha(c) -> bool {
    return isUpper(c) || isLower(c);
}

/* isAlphaNum reports whether c is an ASCII letter or digit. */
func isAlphaNum(c) -> bool {
    return isAlpha(c) || isDigit(c);
}

/* swapCase flips the case of every ASCII letter in s. */
func swapCase(s) {
    let out = "";
    for (c in s) [
        let m = c;
        if (isUpper(c)) [ m = lower(c); ]
        if (isLower(c)) [ m = upper(c); ]
        out = out + m;
    ]
    return out;
}

/* titleCase upper-cases the first letter of every whitespace-separated word. */
func titleCase(s) {
    let out = "";
    let startWord = true;
    for (c in s) [
        let m = c;
        if (startWord) [ m = upper(c); ]
        out = out + m;
        startWord = isSpace(c);
    ]
    return out;
}

/* truncate shortens s to at most `max` chars, appending `suffix` when cut. */
func truncate(s, max: int, suffix) {
    if (s.length() <= max) [ return s; ]
    let keep = max - suffix.length();
    if (keep < 0) [ keep = 0; ]
    return slice(s, 0, keep) + suffix;
}

/* stripPrefix removes prefix from the start of s when it is present. */
func stripPrefix(s, prefix) {
    if (!startsWith(s, prefix)) [ return s; ]
    return substr(s, prefix.length(), s.length() - prefix.length());
}

/* stripSuffix removes suffix from the end of s when it is present. */
func stripSuffix(s, suffix) {
    if (!endsWith(s, suffix)) [ return s; ]
    return slice(s, 0, s.length() - suffix.length());
}

/* commonPrefix returns the longest shared leading run of a and b. */
func commonPrefix(a, b) {
    let n = a.length();
    if (b.length() < n) [ n = b.length(); ]

    let out = "";
    let i = 0;
    while (i < n) [
        if (charAt(a, i) != charAt(b, i)) [ return out; ]
        out = out + charAt(a, i);
        i = i + 1;
    ]
    return out;
}

/* commonSuffix returns the longest shared trailing run of a and b. */
func commonSuffix(a, b) {
    let n = a.length();
    if (b.length() < n) [ n = b.length(); ]

    let out = "";
    let i = 0;
    while (i < n) [
        if (charAt(a, a.length() - 1 - i) != charAt(b, b.length() - 1 - i)) [ return out; ]
        out = charAt(a, a.length() - 1 - i) + out;
        i = i + 1;
    ]
    return out;
}

/* insert returns s with sub placed at index `at`. */
func insert(s, at: int, sub) {
    return slice(s, 0, at) + sub + slice(s, at, s.length());
}

/* removeAt returns s with `count` chars deleted starting at index `at`. */
func removeAt(s, at: int, count: int) {
    return slice(s, 0, at) + slice(s, at + count, s.length());
}

/* equalsIgnoreCase compares a and b while ignoring ASCII case. */
func equalsIgnoreCase(a, b) -> bool {
    return upper(a) == upper(b);
}

/* compare returns a negative number, 0, or a positive number when a sorts
 * before, with, or after b. */
func compare(a, b) -> int {
    if (a < b) [ return -1; ]
    if (a > b) [ return 1; ]
    return 0;
}

/* snakeCase converts camelCase or spaced text into snake_case. */
func snakeCase(s) {
    let out = "";
    for (c in s) [
        let add = c;
        if (isUpper(c)) [ add = "_" + lower(c); ]
        if (isSpace(c)) [ add = "_"; ]
        out = out + add;
    ]
    return out;
}

/* kebabCase converts camelCase or spaced text into kebab-case. */
func kebabCase(s) {
    let out = "";
    for (c in s) [
        let add = c;
        if (isUpper(c)) [ add = "-" + lower(c); ]
        if (isSpace(c)) [ add = "-"; ]
        out = out + add;
    ]
    return out;
}

/* repeatStr concatenates s `times` times (empty result when times <= 0). */
func repeatStr(s, times: int) {
    let out = "";
    let i = 0;
    while (i < times) [
        out = out + s;
        i = i + 1;
    ]
    return out;
}

/* center centres s between pad characters until it reaches width. */
func center(s, width: int, pad) {
    let n = s.length();
    if (n >= width) [ return s; ]
    let total = width - n;
    let out = s;
    let i = 0;
    while (i < total) [
        if (i % 2 == 0) [ out = pad + out; ]
        if (i % 2 == 1) [ out = out + pad; ]
        i = i + 1;
    ]
    return out;
}

/* isAlnum reports whether c is an ASCII letter or digit. */
func isAlnum(c) -> bool {
    if (isAlpha(c)) [ return true; ]
    if (isDigit(c)) [ return true; ]
    return false;
}

/* isLowerChar reports whether c is a lowercase ASCII letter. */
func isLowerChar(c) -> bool {
    let low = "abcdefghijklmnopqrstuvwxyz";
    return low.indexOf(c) >= 0;
}

/* levenshtein returns the edit distance between a and b. */
func levenshtein(a, b) -> int {
    let m = a.length();
    let n = b.length();
    if (m == 0) [ return n; ]
    if (n == 0) [ return m; ]
    let prev = [];
    let i = 0;
    while (i <= m) [ prev.push(i); i = i + 1; ]
    let j = 0;
    while (j < n) [
        let cur = [j + 1];
        let i2 = 0;
        while (i2 < m) [
            let cost = 0;
            if (charAt(a, i2) != charAt(b, j)) [ cost = 1; ]
            let del = prev[i2 + 1] + 1;
            let ins = cur[i2] + 1;
            let sub = prev[i2] + cost;
            let best = del;
            if (ins < best) [ best = ins; ]
            if (sub < best) [ best = sub; ]
            cur.push(best);
            i2 = i2 + 1;
        ]
        prev = cur;
        j = j + 1;
    ]
    return prev[m];
}

/* hamming returns the position differences between equal-length strings,
 * or -1 when the lengths differ. */
func hamming(a, b) -> int {
    let m = a.length();
    if (m != b.length()) [ return -1; ]
    let diff = 0;
    let i = 0;
    while (i < m) [
        if (charAt(a, i) != charAt(b, i)) [ diff = diff + 1; ]
        i = i + 1;
    ]
    return diff;
}

/* reverseWords reverses the order of space-separated words. */
func reverseWords(s) {
    let ws = words(s);
    let out = "";
    let i = ws.length() - 1;
    while (i >= 0) [
        out = out + ws[i];
        if (i > 0) [ out = out + " "; ]
        i = i - 1;
    ]
    return out;
}

/* truncateMiddle keeps `n` characters, replacing the omitted middle with pad. */
func truncateMiddle(s, n: int, pad) {
    let len = s.length();
    if (len <= n) [ return s; ]
    let keep = n - pad.length();
    if (keep < 1) [ return pad; ]
    let left = 0;
    while (left * 2 < keep) [ left = left + 1; ]
    let right = keep - left;
    return slice(s, 0, left) + pad + slice(s, len - right, len);
}

/* mask replaces every character of s in [start, end) with ch. */
func mask(s, start: int, end: int, ch) {
    let out = "";
    let i = 0;
    while (i < s.length()) [
        if (i >= start && i < end) [ out = out + ch; ]
        if (i < start || i >= end) [ out = out + charAt(s, i); ]
        i = i + 1;
    ]
    return out;
}

/* expandTabs replaces each tab with `size` spaces. */
func expandTabs(s, size: int) {
    let pad = repeatStr(" ", size);
    let out = "";
    for (c in s) [
        if (c == "\t") [ out = out + pad; ]
        if (c != "\t") [ out = out + c; ]
    ]
    return out;
}

/* wordCount returns the number of space-separated words in s. */
func wordCount(s) -> int {
    return words(s).length();
}

/* initials returns the upper-cased first letter of every word. */
func initials(s) {
    let ws = words(s);
    let out = "";
    for (w in ws) [ out = out + upper(charAt(w, 0)); ]
    return out;
}

/* isPalindrome reports whether s reads the same forwards and backwards. */
func isPalindrome(s) -> bool {
    return s == reverse(s);
}

/* rotateStr rotates the characters of s by n positions to the right. */
func rotateStr(s, n: int) {
    let len = s.length();
    if (len == 0) [ return s; ]
    let k = n % len;
    if (k < 0) [ k = k + len; ]
    return slice(s, len - k, len) + slice(s, 0, len - k);
}

/* toCharArray splits s into an array of single-character strings. */
func toCharArray(s) {
    let out = [];
    for (c in s) [ out.push(c); ]
    return out;
}

/* fromChars joins an array of characters back into a string. */
func fromChars(a) {
    let out = "";
    for (c in a) [ out = out + c; ]
    return out;
}

/* normalizeSpaces collapses runs of whitespace to a single space. */
func normalizeSpaces(s) {
    let out = "";
    let prevSpace = false;
    for (c in s) [
        if (isSpace(c)) [
            if (!prevSpace) [ out = out + " "; ]
            prevSpace = true;
        ]
        if (!isSpace(c)) [ out = out + c; prevSpace = false; ]
    ]
    return out;
}

/* isTitle reports whether every word of s begins with an upper-case letter. */
func isTitle(s) -> bool {
    let ws = words(s);
    if (ws.length() == 0) [ return false; ]
    for (w in ws) [ if (!isUpper(charAt(w, 0))) [ return false; ] ]
    return true;
}
