/* Std: lazy iterator combinators (Rust-style).
 *
 * Everything is built on the next() iteration protocol of the language:
 * `for (v in it)` works out of the box, and manual pulls keep the optional
 * semantics (`let v = it.next(); if (v) [...]`).
 *
 * Combinators are methods on Iter so they chain:
 *
 *     import "../std/iter.lcui";
 *
 *     let squares = range(1, 10).map(new Square()).filter(new Big()).collect();
 *
 * Mappers and predicates are Fn1/Fn2 subclasses (the script equivalent of
 * implementing an Fn trait):
 *
 *     class Square extends Fn1 {
 *         func call(x) { return x * x; }
 *     }
 *
 * Implementation note: method-local `let` compiles to its own slot, fully
 * decoupled from `this` fields, so names here never collide with a caller's
 * iterator — the earlier unique-naming workaround is no longer needed.
 */

/* Fn1 is the script stand-in for a unary Fn trait: override call(x). */
class Fn1 {
    func call(x) {
        return x;
    }
}

/* Fn2 is the script stand-in for a binary Fn trait: override call(a, b). */
class Fn2 {
    func call(a, b) {
        return b;
    }
}

/* Iter is the lazy iterator base; combinators return new Iters that chain. */
class Iter {
    /* next returns the next element wrapped in optional, or None at the end. */
    func next() {
        return None;
    }

    /* map lazily transforms each element via f. */
    func map(f: Fn1) -> Iter {
        return new MapIter(this, f);
    }

    /* filter keeps only elements where pred returns true. */
    func filter(pred: Fn1) -> Iter {
        return new FilterIter(this, pred);
    }

    /* take yields at most n elements. */
    func take(n: int) -> Iter {
        return new TakeIter(this, n);
    }

    /* takeWhile yields elements until pred first fails. */
    func takeWhile(pred: Fn1) -> Iter {
        return new TakeWhileIter(this, pred);
    }

    /* skip drops the first n elements. */
    func skip(n: int) -> Iter {
        return new SkipIter(this, n);
    }

    /* zip pairs each element with the matching one from `other`. */
    func zip(other: Iter) -> Iter {
        return new ZipIter(this, other);
    }

    /* chain yields this iterator, then `other`. */
    func chain(other: Iter) -> Iter {
        return new ChainIter(this, other);
    }

    /* stepBy yields every n-th element (n >= 1). */
    func stepBy(n: int) -> Iter {
        return new StepByIter(this, n);
    }

    /* collect drains the iterator into an array. */
    func collect() {
        let out = [];
        while (true) [
            let cval = this.next();
            if (!cval) [ break; ]
            out.push(cval);
        ]
        return out;
    }

    /* fold accumulates elements left-to-right from `seed` via f(a, b). */
    func fold(seed, f: Fn2) {
        let acc = seed;
        while (true) [
            let fdval = this.next();
            if (!fdval) [ break; ]
            acc = f.call(acc, fdval);
        ]
        return acc;
    }

    /* sum returns the arithmetic sum of all elements. */
    func sum() {
        let total = 0;
        while (true) [
            let smval = this.next();
            if (!smval) [ break; ]
            total = total + smval;
        ]
        return total;
    }

    /* count returns the number of elements. */
    func count() -> int {
        let num = 0;
        while (true) [
            let cnval = this.next();
            if (!cnval) [ break; ]
            num = num + 1;
        ]
        return num;
    }

    /* forEach invokes f for every element. */
    func forEach(f: Fn1) {
        while (true) [
            let feval = this.next();
            if (!feval) [ break; ]
            f.call(feval);
        ]
    }

    /* any returns true if any element satisfies pred. */
    func any(pred: Fn1) -> bool {
        while (true) [
            let anval = this.next();
            if (!anval) [ return false; ]
            if (pred.call(anval)) [ return true; ]
        ]
        return false;
    }

    /* all returns true if every element satisfies pred. */
    func all(pred: Fn1) -> bool {
        while (true) [
            let alval = this.next();
            if (!alval) [ return true; ]
            if (!pred.call(alval)) [ return false; ]
        ]
        return true;
    }

    /* find returns the first element satisfying pred, or None. */
    func find(pred: Fn1) {
        while (true) [
            let fval = this.next();
            if (!fval) [ return None; ]
            if (pred.call(fval)) [ return fval; ]
        ]
        return None;
    }

    /* position returns the index of the first match, or -1. */
    func position(pred: Fn1) -> int {
        let idx = 0;
        while (true) [
            let pval = this.next();
            if (!pval) [ return -1; ]
            if (pred.call(pval)) [ return idx; ]
            idx = idx + 1;
        ]
        return -1;
    }

    /* last returns the final element, or None if the iterator is empty. */
    func last() {
        let ltail = None;
        while (true) [
            let laval = this.next();
            if (!laval) [ break; ]
            ltail = laval;
        ]
        return ltail;
    }

    /* max returns the largest element, or None if the iterator is empty. */
    func max() {
        let mxseen = false;
        let mxcur = 0;
        while (true) [
            let mxval = this.next();
            if (!mxval) [ break; ]
            if (!mxseen) [ mxcur = mxval; mxseen = true; ]
            if (mxval > mxcur) [ mxcur = mxval; ]
        ]
        if (!mxseen) [ return None; ]
        return mxcur;
    }

    /* min returns the smallest element, or None if the iterator is empty. */
    func min() {
        let mnseen = false;
        let mncur = 0;
        while (true) [
            let mnval = this.next();
            if (!mnval) [ break; ]
            if (!mnseen) [ mncur = mnval; mnseen = true; ]
            if (mnval < mncur) [ mncur = mnval; ]
        ]
        if (!mnseen) [ return None; ]
        return mncur;
    }
}

/* MapIter applies f to each element of src. */
class MapIter extends Iter {
    public: src: Iter; f: Fn1;
    MapIter(s: Iter, m: Fn1) { this.src = s; this.f = m; }
    func next() {
        let mval = this.src.next();
        if (mval) [ return this.f.call(mval); ]
        return None;
    }
}

/* FilterIter keeps src elements where pred holds. */
class FilterIter extends Iter {
    public: src: Iter; pred: Fn1;
    FilterIter(s: Iter, p: Fn1) { this.src = s; this.pred = p; }
    func next() {
        let fv = this.src.next();
        while (fv && !this.pred.call(fv)) [
            fv = this.src.next();
        ]
        return fv;
    }
}

/* TakeIter yields at most n elements from src. */
class TakeIter extends Iter {
    public: src: Iter; n: int; taken: int = 0;
    TakeIter(s: Iter, limit: int) { this.src = s; this.n = limit; }
    func next() {
        if (this.taken >= this.n) [ return None; ]
        this.taken = this.taken + 1;
        return this.src.next();
    }
}

/* TakeWhileIter yields src elements until pred fails. */
class TakeWhileIter extends Iter {
    public: src: Iter; pred: Fn1; done: bool = false;
    TakeWhileIter(s: Iter, p: Fn1) { this.src = s; this.pred = p; }
    func next() {
        if (this.done) [ return None; ]
        let tv = this.src.next();
        if (tv && this.pred.call(tv)) [ return tv; ]
        this.done = true;
        return None;
    }
}

/* SkipIter drops the first n elements of src. */
class SkipIter extends Iter {
    public: src: Iter; n: int; skipped: int = 0;
    SkipIter(s: Iter, limit: int) { this.src = s; this.n = limit; }
    func next() {
        while (this.skipped < this.n) [
            this.skipped = this.skipped + 1;
            let sv = this.src.next();
            if (!sv) [ return None; ]
        ]
        return this.src.next();
    }
}

/* ZipIter yields [a, b] pairs; lcui has no tuples, so small arrays stand in. */
class ZipIter extends Iter {
    public: a: Iter; b: Iter;
    ZipIter(x: Iter, y: Iter) { this.a = x; this.b = y; }
    func next() {
        let zx = this.a.next();
        if (!zx) [ return None; ]
        let zy = this.b.next();
        if (!zy) [ return None; ]
        return [zx, zy];
    }
}

/* ChainIter yields a, then b once a is exhausted. */
class ChainIter extends Iter {
    public: a: Iter; b: Iter; first: bool = true;
    ChainIter(x: Iter, y: Iter) { this.a = x; this.b = y; }
    func next() {
        if (this.first) [
            let cv = this.a.next();
            if (cv) [ return cv; ]
            this.first = false;
        ]
        return this.b.next();
    }
}

/* StepByIter yields every n-th element of src. */
class StepByIter extends Iter {
    public: src: Iter; step: int; pos: int = 0;
    StepByIter(s: Iter, n: int) { this.src = s; this.step = n; }
    func next() {
        let stv = this.src.next();
        while (stv) [
            if (this.pos % this.step == 0) [
                this.pos = this.pos + 1;
                return stv;
            ]
            this.pos = this.pos + 1;
            stv = this.src.next();
        ]
        return None;
    }
}

/* Seeds: range(a, b) iterates [a, b); repeat(v) yields v forever. */

/* RangeIter yields the half-open integer range [start, stop). */
class RangeIter extends Iter {
    public: i: int = 0; end: int = 0;
    RangeIter(start: int, stop: int) { this.i = start; this.end = stop; }
    func next() {
        if (this.i >= this.end) [ return None; ]
        let rval = this.i;
        this.i = this.i + 1;
        return rval;
    }
}

/* RepeatIter yields `value` forever. */
class RepeatIter extends Iter {
    public: v = 0;
    RepeatIter(value) { this.v = value; }
    func next() {
        return this.v;
    }
}

/* range builds a half-open integer iterator over [start, stop). */
func range(start: int, end: int) -> RangeIter {
    return new RangeIter(start, end);
}

/* repeat builds an infinite iterator that always yields `value`. */
func repeat(value) -> RepeatIter {
    return new RepeatIter(value);
}
